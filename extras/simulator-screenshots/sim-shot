#!/usr/bin/env python3
"""Save a shrunk iOS Simulator screenshot as a new PNG and print its path."""

from __future__ import annotations

import sys

# Run again in isolated mode before any other import, so PYTHON* variables and user site packages cannot shadow the library.
if __name__ == "__main__" and not sys.flags.isolated and sys.executable:
    import posix

    posix.execv(sys.executable, [sys.executable, "-I", *sys.argv])

import argparse
import os
import subprocess
import tempfile

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__)))), "lib"))

from agent_safeguards.common import find_executable, message  # noqa: E402

TOOL_NAME = "sim-shot"
XCRUN = find_executable("xcrun")
SIPS = find_executable("sips")
DEFAULT_MAX_SIDE = 600
MIN_MAX_SIDE = 100
MAX_MAX_SIDE = 1600
CAPTURE_TIMEOUT_SECONDS = 45
SHRINK_TIMEOUT_SECONDS = 30


def fail(text: str) -> None:
    print("%s: %s" % (TOOL_NAME, text), file=sys.stderr)
    sys.exit(1)


def side_lengths(path: str) -> list[int] | None:
    done = subprocess.run([SIPS, "-g", "pixelWidth", "-g", "pixelHeight", path], capture_output=True, text=True, timeout=SHRINK_TIMEOUT_SECONDS)
    values = [int(line.split(":")[1]) for line in done.stdout.splitlines() if "pixel" in line]
    return values if len(values) == 2 else None


def reserve_output(requested: str | None) -> str:
    # The command can run without a prompt, so it only ever creates new .png files. Creating the file with O_EXCL
    # claims the path atomically, which also means the cleanup on failure only ever removes a file this run made.
    if requested is None:
        handle, path = tempfile.mkstemp(prefix="sim-shot-", suffix=".png")
        os.close(handle)
        return path
    path = os.path.abspath(requested)
    if not path.lower().endswith(".png"):
        fail(message("sim_shot.error.not_png"))
    if not os.path.isdir(os.path.dirname(path)):
        fail(message("sim_shot.error.no_folder", path=os.path.dirname(path)))
    try:
        os.close(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o666))
    except FileExistsError:
        fail(message("sim_shot.error.exists", path=path))
    except OSError:
        fail(message("sim_shot.error.not_writable", path=path))
    return path


def capture(device: str, destination: str) -> None:
    hint = message("sim_shot.hint")
    try:
        captured = subprocess.run(
            [XCRUN, "simctl", "io", device, "screenshot", "--type=png", destination],
            capture_output=True,
            text=True,
            timeout=CAPTURE_TIMEOUT_SECONDS,
        )
    except subprocess.TimeoutExpired:
        fail(message("sim_shot.error.timeout", seconds=CAPTURE_TIMEOUT_SECONDS, hint=hint))
    if captured.returncode != 0 or not os.path.getsize(destination):
        reason = (captured.stderr or captured.stdout).strip().splitlines()
        fail(message("sim_shot.error.capture", reason=reason[-1].strip() if reason else "-", hint=hint))


def shrink(source: str, destination: str, max_side: int) -> None:
    shrunk = subprocess.run([SIPS, "-Z", str(max_side), source, "--out", destination], capture_output=True, text=True, timeout=SHRINK_TIMEOUT_SECONDS)
    if shrunk.returncode != 0:
        fail(message("sim_shot.error.shrink", hint=message("sim_shot.hint")))
    sides = side_lengths(destination)
    if sides is None or max(sides) > max_side:
        fail(message("sim_shot.error.size"))


def main(arguments: list[str]) -> int:
    parser = argparse.ArgumentParser(prog=TOOL_NAME, usage=message("sim_shot.usage"), add_help=False)
    parser.add_argument("output", nargs="?")
    parser.add_argument("--device", default="booted")
    parser.add_argument("--max-side", type=int, default=DEFAULT_MAX_SIDE)
    args = parser.parse_args(arguments)
    if XCRUN is None or SIPS is None:
        fail(message("sim_shot.error.no_tools"))
    if not MIN_MAX_SIDE <= args.max_side <= MAX_MAX_SIDE:
        fail(message("sim_shot.error.range", low=MIN_MAX_SIDE, high=MAX_MAX_SIDE))

    output = reserve_output(args.output)
    full = None
    succeeded = False
    try:
        # simctl is refused with "Operation not permitted" when it writes into Documents or other protected folders,
        # so the full-size capture goes to the temp folder and only sips writes the final file.
        handle, full = tempfile.mkstemp(prefix="sim-shot-full-", suffix=".png")
        os.close(handle)
        capture(args.device, full)
        shrink(full, output, args.max_side)
        succeeded = True
    finally:
        for leftover in (full,) if succeeded else (full, output):
            if leftover is not None:
                try:
                    os.remove(leftover)
                except OSError:
                    pass
    print(output)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
