# Each decision carries its reason so the agent learns the exact rewrite instead of a bare refusal.
class Denied(Exception):
    pass


class RemoteDenied(Denied):
    pass


class CheckTooSlow(BaseException):
    """Raised by the budget alarm; it is not an Exception, so no handler inside a check can swallow it."""


def _on_budget_alarm(signal_number: int, frame: object) -> None:
    raise CheckTooSlow


def _run_with_budget(check) -> None:
    if not hasattr(signal, "setitimer"):
        check()
        return
    previous = signal.signal(signal.SIGALRM, _on_budget_alarm)
    signal.setitimer(signal.ITIMER_REAL, HOOK_BUDGET_SECONDS)
    try:
        check()
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, previous)


# Set to the allowed folders while a command meant for another machine is checked, and to None otherwise.
_REMOTE: list[tuple[str, ...] | None] = [None]
_SCRIPT_STACK: list[str] = []
# Permanent delete targets of a remote command that passed the lexical rule, for the machine to check physically.
_REMOTE_TARGETS: list[tuple[str, bool]] = []
# Scripts already read in this run and found clean, by path, size, modification time and folder.
_SCRIPT_CACHE: dict[tuple, bool] = {}


def _remote_roots() -> tuple[str, ...]:
    configured = os.environ.get("AGENT_SAFEGUARDS_REMOTE_DELETE_ROOTS")
    entries = DEFAULT_REMOTE_ROOTS if configured is None else tuple(entry for entry in re.split(r"[:,\s]+", configured) if entry)
    roots = []
    for entry in entries:
        entry = entry.rstrip("/")
        parts = entry.split("/")
        anchored = entry.startswith("~/") or entry.startswith("/")
        if anchored and len(parts) >= 2 and not REMOTE_UNSAFE_PATH.search(entry) and all(part not in {"", ".", ".."} for part in parts[1:]) and entry not in SYSTEM_ROOTS:
            roots.append(entry)
    return tuple(roots)


def _emit_deny(denial: Denied) -> None:
    if isinstance(denial, RemoteDenied):
        emit_decision("deny", message("delete_guard.deny_remote", reason=str(denial), roots=", ".join(_remote_roots())))
    else:
        emit_decision("deny", message("delete_guard.deny", reason=str(denial)))


# Each command keeps the separators around it so a directory change is only trusted where it surely runs.
class Chunk(NamedTuple):
    words: list[str]
    before: str | None
    after: str | None
    opened: bool
    redirected: bool
    redirections: tuple[tuple[str, str, str], ...] = ()


# `name() {`, `name () {` and `function name {` only define what follows; the command inside is what the guard must see.
def _function_header_length(words: list[str]) -> int:
    text = ""
    length = 0
    for count, word in enumerate(words[:6], 1):
        text = text + " " + word if text else word
        if FUNCTION_HEADER.fullmatch(text) and ("(" in text or text.startswith("function")):
            length = count
    while length and words[length : length + 1] == ["{"]:
        length += 1
    return length


# `coproc cmd` and `coproc NAME { cmd; }` run the command that follows; `case WORD in PATTERN) cmd` and a later `PATTERN) cmd` run
# the command after the pattern. The prefix is not a command, so it is dropped and the command is looked at.
def _without_syntax_prefix(words: list[str]) -> list[str]:
    if words[:1] == ["coproc"]:
        words = words[1:]
        if len(words) > 1 and (words[1] == "{" or words[1].startswith("(")) and re.fullmatch(r"[A-Za-z_]\w*", words[0]):
            words = words[1:]
    if words[:1] == ["case"] and "in" in words[2:]:
        words = words[words.index("in", 2) + 1 :]
    return words


def _chunk(
    raw_words: list[str], before: str | None, after: str | None, redirected: bool, redirections: tuple[tuple[str, str, str], ...] = ()
) -> Chunk:
    words = [word for word in raw_words if word]
    header = _function_header_length(words)
    opened = header > 0 or (bool(words) and (words[0].startswith("(") or words[0] == "{"))
    words = _without_syntax_prefix(words[header:])
    opened = opened or (bool(words) and (words[0].startswith("(") or words[0] == "{"))
    while words and words[0].startswith("("):
        words[0] = words[0][1:]
        if not words[0]:
            words.pop(0)
    # A word that ends in a parenthesis and is followed by more words is the pattern of a case arm (`x) cmd`); the last word
    # of a subshell (`(cmd)`) has nothing after it.
    if len(words) > 1 and words[0].endswith(")") and not words[0].startswith("$("):
        words = words[1:]
    if words and words[-1].endswith(")"):
        words[-1] = words[-1].rstrip(")")
        if not words[-1]:
            words.pop()
    # Only now are the quoted and escaped parentheses given back, so that they were not taken for the end of a group.
    return Chunk([word.translate(UNPROTECT_SEPARATORS) for word in words], before, after, opened, redirected, redirections)


# An escaped or quoted separator (the \\; that ends a find command, the '|' given to env) is a word, not the end of the command,
# so it is swapped for a private character the lexer leaves alone and swapped back in the words.
ESCAPED_SEPARATORS = {";": "\ue010", "&": "\ue011", "|": "\ue012", "\n": "\ue013", "(": "\ue014", ")": "\ue015"}


UNPROTECT_SEPARATORS = {ord(private): original for original, private in ESCAPED_SEPARATORS.items()}


def _protect_escaped_separators(text: str) -> str:
    out: list[str] = []
    quote = ""
    index = 0
    while index < len(text):
        character = text[index]
        if quote:
            if character == quote:
                quote = ""
            elif quote == '"' and character == "\\":
                # The backslash stays a character of the word before anything but $ ` " \ and a line break.
                following = text[index + 1 : index + 2]
                out.append("\\" + ESCAPED_SEPARATORS[following] if following in ESCAPED_SEPARATORS and following != "\n" else text[index : index + 2])
                index += 2
                continue
            elif character in ESCAPED_SEPARATORS:
                out.append(ESCAPED_SEPARATORS[character])
                index += 1
                continue
        elif character in "'\"":
            quote = character
        elif character == "\\" and text[index + 1 : index + 2] in ESCAPED_SEPARATORS:
            out.append(ESCAPED_SEPARATORS[text[index + 1]])
            index += 2
            continue
        elif character == "\\":
            out.append(text[index : index + 2])
            index += 2
            continue
        out.append(character)
        index += 1
    return "".join(out)


def _tokenize(command: str) -> list[Chunk] | None:
    recorded: list[tuple[str, str, str]] = []
    try:
        lexer = shlex.shlex(_protect_escaped_separators(normalize_command(command, recorded)), posix=True, punctuation_chars=";&|\n")
        lexer.whitespace = " \t\r"
        lexer.whitespace_split = True
        lexer.commenters = ""
        tokens = list(lexer)
    except ValueError:
        return None
    chunks: list[Chunk] = []
    words: list[str] = []
    before: str | None = None
    redirected = False
    # The n-th marker stands for the n-th redirection that normalize_command recorded, so each command keeps its own.
    redirections: list[tuple[str, str, str]] = []
    records = iter(recorded)
    for token in tokens:
        if token == REDIRECTION_MARKER:
            redirected = True
            record = next(records, None)
            if record is not None:
                redirections.append(record)
        elif token and all(character in ";&|\n" for character in token):
            # A line break beside an operator only continues it, so "&&" plus a newline is still "&&".
            stripped = token.replace("\n", "")
            separator = stripped if stripped and set(stripped) != {";"} else ";"
            if words or redirections:
                chunks.append(_chunk(words, before, separator, redirected, tuple(redirections)))
                words, redirected, redirections = [], False, []
            before = separator
        else:
            words.append(token)
    if words or redirections:
        chunks.append(_chunk(words, before, None, redirected, tuple(redirections)))
    return [chunk for chunk in chunks if chunk.words or chunk.opened or chunk.redirections]


def _base(word: str) -> str:
    return os.path.basename(word)


def _is_computed(path: str) -> bool:
    return any(marker in path for marker in ("$", "`")) and not re.fullmatch(r"(\$HOME|\$\{HOME\})(/.*)?", path)


def _home_expanded(path: str) -> str:
    path = re.sub(r"^(\$HOME|\$\{HOME\})", USER_HOME, path)
    return USER_HOME + path[1:] if path == "~" or path.startswith("~/") else path


# A command that sets HOME (or reads it from input) makes `$HOME` and `~` a place the guard cannot know, not the home of the user.
HOME_ASSIGNMENT = re.compile(r"(?<![\w$])HOME\s*\+?=|\b(?:read|mapfile|readarray|unset)\b[^;&|\n]*\bHOME\b")
HOME_FORM = re.compile(r"(?:\$HOME|\$\{HOME\}|~)(?:/|$)")
_HOME_CHANGED = [False]


def _expand(path: str, cwd: str | None) -> str | None:
    if _HOME_CHANGED[0] and HOME_FORM.match(path):
        return None
    path = _home_expanded(path)
    if path.startswith("~"):
        return None
    if not os.path.isabs(path):
        if cwd is None:
            return None
        path = os.path.join(cwd, path)
    return os.path.realpath(path)


def _glob_base(path: str) -> str:
    match = re.search(r"[*?\[]", path)
    if not match:
        return path
    head = path[: match.start()]
    return head if head.endswith("/") or not head else os.path.dirname(head) or "."


def _inside(path: str, root: str) -> bool:
    return path == root or path.startswith(root.rstrip("/") + "/")


def _protected(path: str) -> bool:
    if path in SYSTEM_ROOT_PATHS or path in TEMP_ROOTS or path == USER_HOME:
        return True
    if _inside(USER_HOME, path):
        return True
    if os.path.dirname(path) == USER_HOME:
        return True
    return os.path.dirname(path) in MOUNT_PARENTS


def _names_trash(path: str) -> bool:
    path = path.replace("\\", "/")
    return TRASH_URI.match(path) is not None or any(TRASH_FOLDER.fullmatch(part) for part in path.split("/")) or TRASH_HOME_FOLDER.search(path) is not None


# The home Trash folders of this user, which also covers a data folder moved with XDG_DATA_HOME.
def _trash_roots() -> tuple[str, ...]:
    roots = [os.path.join(USER_HOME, ".Trash"), os.path.join(USER_HOME, ".local", "share", "Trash")]
    data_home = os.environ.get("XDG_DATA_HOME", "")
    if data_home.startswith("/"):
        roots.append(os.path.join(os.path.normpath(data_home), "Trash"))
    return tuple(dict.fromkeys(roots + [os.path.realpath(root) for root in roots]))


# A folder with a Trash directly inside it (the top of a volume) would take the Trash along when it is deleted or moved. A
# folder that cannot be looked through completely is not shown to be free of one.
def _holds_trash(path: str) -> bool:
    roots = frozenset(_trash_roots())
    try:
        with os.scandir(path) as entries:
            for count, entry in enumerate(entries):
                if count >= MAX_TRASH_SCAN:
                    return True
                if TRASH_FOLDER.fullmatch(entry.name) and (TRASH_FILE_NAME.fullmatch(entry.name) or _is_folder(entry)):
                    return True
                # The Trash of this user has a plain name (Trash) when the data folder is moved, so its path is what tells.
                if entry.path in roots or os.path.realpath(entry.path) in roots:
                    return True
    except (FileNotFoundError, NotADirectoryError):
        return False
    except OSError:
        return True
    return False


def _is_folder(entry: os.DirEntry) -> bool:
    try:
        return entry.is_dir()
    except OSError:
        return True


# What a glob matches in the real folders, the way a shell reads it: `*`, `?` and classes (`[!x]` and `[^x]` both negate),
# no match for a leading dot unless the pattern has one, and `**` for any number of folders (links are not followed there).
# More matches or entries than the bounds, or a folder that cannot be listed, is a refusal: a bound limits the work, it does
# not widen what is allowed.
def _glob_matches(raw: str, cwd: str | None, verb: str) -> list[str]:
    if not re.search(r"[*?\[]", raw):
        return []
    pattern = _home_expanded(raw)
    if not os.path.isabs(pattern):
        if cwd is None:
            return []
        pattern = os.path.join(cwd, pattern)
    matches: list[str] = []
    folders_only = pattern.endswith("/")
    _glob_walk("/", [part for part in pattern.split("/") if part], matches, [GLOB_VISITS], verb, raw, folders_only)
    return matches


def _glob_entries(base: str, visits: list[int], verb: str, raw: str) -> list[os.DirEntry]:
    try:
        with os.scandir(base) as entries:
            found = list(itertools.islice(entries, visits[0] + 1))
    except (FileNotFoundError, NotADirectoryError):
        return []
    except OSError:
        raise Denied(message("delete_guard.reason.expansion", verb=verb, raw=raw)) from None
    visits[0] -= len(found)
    if visits[0] < 0:
        raise Denied(message("delete_guard.reason.expansion", verb=verb, raw=raw))
    return found


def _glob_walk(base: str, parts: list[str], matches: list[str], visits: list[int], verb: str, raw: str, folders_only: bool) -> None:
    if not parts:
        if folders_only and not _is_folder_path(base, verb, raw):
            return
        matches.append(base)
        if len(matches) > MAX_MATCHES:
            raise Denied(message("delete_guard.reason.expansion", verb=verb, raw=raw))
        return
    part, rest = parts[0], parts[1:]
    if part == "**" and (rest or folders_only):
        _glob_walk(base, rest, matches, visits, verb, raw, folders_only)
        for entry in _glob_entries(base, visits, verb, raw):
            if not entry.name.startswith(".") and _is_plain_folder(entry, verb, raw):
                _glob_walk(entry.path, parts, matches, visits, verb, raw, folders_only)
    elif re.search(r"[*?\[]", part):
        tokens = _glob_tokens(part)
        for entry in _glob_entries(base, visits, verb, raw):
            if (part.startswith(".") or not entry.name.startswith(".")) and _glob_match(tokens, entry.name):
                _glob_walk(entry.path, rest, matches, visits, verb, raw, folders_only)
    else:
        path = os.path.join(base, part)
        try:
            os.lstat(path)
        except (FileNotFoundError, NotADirectoryError):
            return
        except OSError:
            raise Denied(message("delete_guard.reason.expansion", verb=verb, raw=raw)) from None
        _glob_walk(path, rest, matches, visits, verb, raw, folders_only)


# A shell pattern as tokens: `*`, `?`, literal characters and classes with `!` or `^` for negation, ranges and the named
# classes. The named classes also take any non-ASCII character, because the shell's locale may count it as a letter.
def _glob_tokens(pattern: str) -> list[tuple[str, object]]:
    tokens: list[tuple[str, object]] = []
    index = 0
    length = len(pattern)
    while index < length:
        character = pattern[index]
        if character == "*":
            if not tokens or tokens[-1][0] != "*":
                tokens.append(("*", ""))
        elif character == "?":
            tokens.append(("?", ""))
        elif character == "\\" and index + 1 < length:
            tokens.append(("lit", pattern[index + 1]))
            index += 1
        elif character == "[":
            position = index + 1
            negate = position < length and pattern[position] in "!^"
            position += 1 if negate else 0
            members: list[str] = []
            first = True
            while position < length and (pattern[position] != "]" or first):
                first = False
                if pattern.startswith("[:", position):
                    end = pattern.find(":]", position + 2)
                    name = pattern[position + 2 : end] if end != -1 else ""
                    if name in POSIX_CLASSES:
                        # The wide form (any non-ASCII name may belong) is the safe one for a class, the ASCII form for a negated one.
                        members.append((POSIX_CLASSES_ASCII if negate else POSIX_CLASSES)[name])
                        position = end + 2
                        continue
                members.append("-" if pattern[position] == "-" else re.escape(pattern[position]))
                position += 1
            if position >= length:
                tokens.append(("lit", character))
            else:
                tokens.append(("set", re.compile("[" + ("^" if negate else "") + "".join(members) + "]")))
                index = position
        else:
            tokens.append(("lit", character))
        index += 1
    return tokens


def _glob_token_matches(token: tuple[str, object], character: str) -> bool:
    kind, value = token
    if kind == "?":
        return True
    if kind == "lit":
        return value == character
    return value.fullmatch(character) is not None  # type: ignore[union-attr]


# The usual two-pointer match: a star remembers where it was so the pattern can be tried again one name character further.
def _glob_match(tokens: list[tuple[str, object]], name: str) -> bool:
    token = position = 0
    star = -1
    mark = 0
    while position < len(name):
        if token < len(tokens) and tokens[token][0] != "*" and _glob_token_matches(tokens[token], name[position]):
            token += 1
            position += 1
        elif token < len(tokens) and tokens[token][0] == "*":
            star, mark = token, position
            token += 1
        elif star != -1:
            token = star + 1
            mark += 1
            position = mark
        else:
            return False
    while token < len(tokens) and tokens[token][0] == "*":
        token += 1
    return token == len(tokens)


def _is_folder_path(path: str, verb: str, raw: str) -> bool:
    try:
        return stat.S_ISDIR(os.stat(path).st_mode)
    except (FileNotFoundError, NotADirectoryError):
        return False
    except OSError:
        raise Denied(message("delete_guard.reason.expansion", verb=verb, raw=raw)) from None


def _is_plain_folder(entry: os.DirEntry, verb: str, raw: str) -> bool:
    try:
        return entry.is_dir(follow_symlinks=False)
    except OSError:
        raise Denied(message("delete_guard.reason.expansion", verb=verb, raw=raw)) from None


# A name from find or xargs is unknown, and a path built from it names something the guard has not checked.
def _check_match_mark(raw: str, verb: str) -> None:
    if MATCH_MARK in raw:
        raise Denied(message("delete_guard.reason.match_path", verb=verb, raw=raw.replace(MATCH_MARK, "{}")))


def _check_resolved(resolved: str, cwd: str | None, recursive: bool, verb: str) -> None:
    if _protected(resolved):
        raise Denied(message("delete_guard.reason.protected_folder", verb=verb, path=resolved))
    if any(_inside(resolved, root) for root in TEMP_ROOTS):
        return
    root = _repository_root(cwd)
    if root is None or not _inside(resolved, root):
        raise Denied(message("delete_guard.reason.outside_repository", verb=verb, path=resolved))
    if resolved == root:
        raise Denied(message("delete_guard.reason.repository_root", verb=verb, path=resolved))
    if resolved == os.path.join(root, ".git") or _inside(resolved, os.path.join(root, ".git")):
        raise Denied(message("delete_guard.reason.git_metadata", verb=verb, path=resolved))
    if recursive and os.path.isdir(resolved) and os.path.isfile(os.path.join(resolved, ".git")):
        raise Denied(message("delete_guard.reason.worktree", path=resolved))


def _check_sendable(resolved: str) -> None:
    if _in_trash(resolved) or any(_inside(root, resolved) for root in _trash_roots()):
        raise Denied(message("delete_guard.reason.trash_inside", path=resolved))
    if _protected(resolved):
        raise Denied(message("delete_guard.reason.trash_protected", path=resolved))


# gio, gvfs and kio take locations as well as paths. A file: location is the path it names; any other place (sftp:, smb:)
# is out of sight, so a permanent delete there is refused and a Trash location is judged by its name.
def _location_path(raw: str, verb: str, *, strict: bool = True) -> str:
    if _REMOTE[0] is not None or TRASH_URI.match(raw) or not LOCATION_SCHEME.match(raw):
        return raw
    parts = urllib.parse.urlsplit(raw)
    if parts.scheme.lower() == "file" and parts.netloc in {"", "localhost"}:
        return urllib.parse.unquote(parts.path)
    if strict:
        raise Denied(message("delete_guard.reason.location", verb=verb, raw=raw))
    return raw


def _in_trash(path: str) -> bool:
    return _names_trash(path) or _inside(path, "/boot/trash") or any(_inside(path, root) for root in _trash_roots())


# The literal form of a path written for another machine, or None when the shell over there could read it differently.
def _remote_literal(raw: str) -> str | None:
    path = raw if raw == "/" else raw.rstrip("/")
    anchored = path.startswith("~/") or path.startswith("/")
    components = path.split("/")[1:] if anchored else []
    if not anchored or REMOTE_UNSAFE_PATH.search(path) or not components or any(part in {"", ".", ".."} for part in components):
        return None
    return path


# Sending a file to a remote Trash can be undone, so it needs no allowed folder, but the home folder, what sits directly in
# it and the system folders stay out of reach just as they do on this machine.
def _remote_trash_protected(path: str) -> bool:
    parts = path.strip("/").split("/")
    if path.startswith("~/"):
        return len(parts) < 3
    top = "/" + parts[0]
    if top in REMOTE_TRASH_SYSTEM_TREES:
        return True
    if top in REMOTE_HOME_PARENTS:
        return len(parts) < 4
    if top == "/root":
        return len(parts) < 3
    if top in SYSTEM_ROOTS:
        return len(parts) < 3
    return len(parts) < 2


# The answer is cached because one command can name hundreds of targets that all resolve against the same folder.
@functools.lru_cache(maxsize=32)
def _repository_root(cwd: str | None) -> str | None:
    if cwd is None or GIT_PATH is None or not os.path.isdir(cwd):
        return None
    try:
        completed = subprocess.run(
            [GIT_PATH, "-C", cwd, "rev-parse", "--show-toplevel"],
            stdin=subprocess.DEVNULL,
            capture_output=True,
            timeout=5,
            check=False,
            env={"PATH": "/usr/bin:/bin", "HOME": USER_HOME, "LC_ALL": "C"},
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if completed.returncode != 0:
        return None
    root = os.path.realpath(completed.stdout.decode("utf-8", "replace").strip())
    return None if not root or _protected(root) else root


def _check_remote_target(raw: str, verb: str) -> None:
    path = _remote_literal(raw)
    if path is None or not any(path.startswith(root + "/") for root in _REMOTE[0] or ()):
        raise RemoteDenied(message("delete_guard.reason.remote_target", verb=verb, raw=raw))
    # A folder written with a trailing slash, and the folder rsync fills, are entered, so a link there leads out; any other
    # target is removed itself, and a link to remove is no escape.
    entered = raw.endswith("/") and raw != "/"
    _REMOTE_TARGETS.append((path, entered or verb.startswith("rsync")))
    if verb.startswith("rsync") and not entered:
        # What rsync removes from a source may be a file, whose own folder is the only thing to resolve.
        _REMOTE_TARGETS.append((path, False))


def _check_remote_trash_target(raw: str) -> None:
    path = _remote_literal(raw)
    if path is None or _remote_trash_protected(path):
        raise RemoteDenied(message("delete_guard.reason.remote_trash", raw=raw))
    if _names_trash(path):
        raise RemoteDenied(message("delete_guard.reason.trash_inside", path=raw))


def _check_target(raw: str, cwd: str | None, *, recursive: bool, verb: str) -> None:
    if _names_trash(raw):
        raise Denied(message("delete_guard.reason.trash_purge", verb=verb, path=raw))
    if _REMOTE[0] is not None:
        _check_remote_target(raw, verb)
        return
    _check_match_mark(raw, verb)
    if "{" in raw and BRACE_PATTERN.search(raw):
        variants = expand_braces(raw)
        if variants is None:
            raise Denied(message("delete_guard.reason.expansion", verb=verb, raw=raw))
        for variant in variants:
            _check_target(variant, cwd, recursive=recursive, verb=verb)
        return
    if _is_computed(raw):
        if recursive:
            raise Denied(message("delete_guard.reason.computed_path", verb=verb, raw=raw))
        return
    base = _glob_base(raw)
    if base != raw and recursive and not base.strip("./"):
        raise Denied(message("delete_guard.reason.bare_glob", verb=verb, raw=raw))
    wildcard = re.search(r"[*?\[]", raw)
    if wildcard and recursive:
        component_end = raw.find("/", wildcard.start())
        if component_end != -1 and raw[component_end:].strip("/"):
            raise Denied(message("delete_guard.reason.glob_midpath", verb=verb, raw=raw))
    resolved = _expand(base, cwd)
    if resolved is None:
        raise Denied(message("delete_guard.reason.unresolvable", verb=verb, raw=raw))
    if _in_trash(resolved):
        raise Denied(message("delete_guard.reason.trash_purge", verb=verb, path=resolved))
    for match in _glob_matches(raw, cwd, verb):
        found = os.path.realpath(match)
        if _names_trash(match) or _in_trash(found) or (recursive and _is_folder_path(found, verb, raw) and _holds_trash(found)):
            raise Denied(message("delete_guard.reason.trash_purge", verb=verb, path=match))
        _check_resolved(found, cwd, recursive, verb)
    if recursive and base == raw and _is_folder_path(resolved, verb, raw) and _holds_trash(resolved):
        raise Denied(message("delete_guard.reason.trash_holder", verb=verb, path=resolved))
    # A glob under a temp root is cleanup of scratch folders only when a literal name comes before the first wildcard.
    if base != raw and resolved in TEMP_ROOTS:
        first_component = raw[len(base) :].lstrip("/").split("/")[0]
        if re.search(r"[A-Za-z0-9_]", re.split(r"[*?\[]", first_component)[0]):
            return
    _check_resolved(resolved, cwd, recursive, verb)


def _rm(words: list[str], cwd: str | None) -> None:
    recursive = False
    targets: list[str] = []
    options_done = False
    for word in words[1:]:
        if not options_done and word == "--":
            options_done = True
        elif not options_done and word.startswith("--"):
            name = word[2:].split("=", 1)[0]
            matches = [option for option in RM_LONG_OPTIONS if option == name] or [option for option in RM_LONG_OPTIONS if option.startswith(name)]
            # An option that cannot be told is taken for the recursive one: the stricter rules then apply.
            recursive = recursive or len(matches) != 1 or matches[0] in {"recursive", "dir"}
        elif not options_done and word.startswith("-") and len(word) > 1:
            recursive = recursive or bool(set(word[1:]) & {"r", "R", "d"})
        else:
            targets.append(word)
    for target in targets:
        _check_target(target, cwd, recursive=recursive, verb=_base(words[0]) + (" -r" if recursive else ""))


# Moving a file to the Trash can be undone, so it is allowed wherever the folder is not protected. Emptying the Trash cannot,
# so -e and -s (macOS), --empty and --secure are refused; the options that take a folder or only change the output are not.
def _trash(words: list[str], cwd: str | None) -> None:
    targets: list[str] = []
    options_done = False
    skip = False
    for word in words[1:]:
        if skip:
            skip = False
        elif not options_done and word == "--":
            options_done = True
        elif not options_done and word.startswith("--"):
            if word.split("=", 1)[0] in {"--empty", "--secure"}:
                raise Denied(message("delete_guard.reason.trash_empty", name=_base(words[0])))
            skip = word in TRASH_VALUE_OPTIONS
        elif not options_done and word.startswith("-") and len(word) > 1:
            if set(word[1:]) & {"e", "s"}:
                raise Denied(message("delete_guard.reason.trash_empty", name=_base(words[0])))
        else:
            targets.append(word)
    for target in targets:
        if TRASH_URI.match(target):
            continue
        if _REMOTE[0] is not None:
            _check_remote_trash_target(target)
            continue
        variants = expand_braces(target) if "{" in target else [target]
        if variants is None:
            raise Denied(message("delete_guard.reason.expansion", verb="trash", raw=target))
        for variant in variants:
            _trash_one(_location_path(variant, "trash", strict=False), cwd)


def _trash_one(target: str, cwd: str | None) -> None:
    if _names_trash(target):
        raise Denied(message("delete_guard.reason.trash_inside", path=target))
    _check_match_mark(target, "trash")
    if _is_computed(target):
        return
    resolved = _expand(_glob_base(target), cwd)
    if resolved is None:
        return
    _check_sendable(resolved)
    for match in _glob_matches(target, cwd, "trash"):
        found = os.path.realpath(match)
        if _names_trash(match) or (_is_folder_path(found, "trash", target) and _holds_trash(found)):
            raise Denied(message("delete_guard.reason.trash_inside", path=match))
        _check_sendable(found)
    if _glob_base(target) == target and _is_folder_path(resolved, "trash", target) and _holds_trash(resolved):
        raise Denied(message("delete_guard.reason.trash_inside", path=resolved))


# `gio trash` can be undone; `gio remove` deletes for good, so each of its operands is held to the delete rules.
def _gio(words: list[str], cwd: str | None) -> None:
    verb = words[1] if len(words) > 1 else ""
    if verb == "trash":
        _trash(words[1:], cwd)
    elif verb in {"remove", "rm"}:
        for operand in split_options(words[2:], "", frozenset()):
            _check_target(_location_path(operand, "gio remove"), cwd, recursive=False, verb="gio remove")


# The first word of a command after its wrappers, and the first KIO command among its operands.
def _kio_command(words: list[str]) -> str | None:
    operands = split_options(words[1:], "", frozenset())
    return next((operand for operand in operands if operand in KIO_COMMANDS), None)


# Whether a command that find or xargs runs deletes or sends files away, which makes the folder find starts in a target.
def _deletes_files(command: list[str]) -> bool:
    try:
        stripped = strip_wrappers(command)
    except UnresolvableCommand:
        return True
    if not stripped:
        return False
    name = _base(stripped[0])
    if name in XARGS_DELETERS or name in TRASH_TOOLS:
        return True
    if name == "gio":
        return stripped[1:2] != [] and stripped[1] in GIO_DELETE_VERBS
    if KIO_TOOL.fullmatch(name):
        return _kio_command(stripped) in KIO_REMOVE_VERBS
    return False


class FindParts(NamedTuple):
    starts: list
    executions: list
    deletes: bool
    follows: bool
    global_follow: list
    input_roots: bool


# find's words by role: the global options, the folders it starts in (BSD `-f` adds one), and the expression, whose predicates
# take a known number of values and whose -exec bodies run up to their terminator. A value is never read as a predicate.
def _find_parts(words: list[str]) -> FindParts:
    starts: list[str] = []
    executions: list[tuple[str, list[str]]] = []
    global_follow: list[str] = []
    index = 1
    while index < len(words) and (words[index] in FIND_GLOBAL_OPTIONS or words[index].startswith(("-D", "-O")) or words[index] == "-f"):
        word = words[index]
        if word == "-f" and index + 1 < len(words):
            starts.append(words[index + 1])
            index += 1
        elif word in {"-D", "-O"}:
            index += 1
        elif word in {"-L", "-H"}:
            global_follow.append(word)
        index += 1
    while index < len(words) and not (words[index].startswith("-") or words[index] in {"(", "!", "\\("}):
        starts.append(words[index])
        index += 1
    deletes = follows = input_roots = False
    while index < len(words):
        word = words[index]
        if word in FIND_EXEC_PREDICATES:
            # A + ends the command only after {}; anywhere else it is an argument of the command.
            end = next(
                (
                    position
                    for position in range(index + 1, len(words))
                    if words[position] in {";", "\\;"} or (words[position] == "+" and words[position - 1] == "{}")
                ),
                len(words),
            )
            executions.append((word, words[index + 1 : end]))
            index = end
        elif word == "-delete":
            deletes = True
        elif word == "-follow":
            follows = True
        elif word == "-files0-from":
            input_roots = True
            index += 1
        elif word == "-fprintf":
            index += 2
        elif word in FIND_VALUE_PREDICATES or FIND_NEWER_PREDICATE.fullmatch(word):
            index += 1
        index += 1
    return FindParts(starts, executions, deletes, follows, global_follow, input_roots)


# A find or an rsync that deletes takes its folders from the names the outer command supplies, which are not known here.
def _deletes_from_names(command: list[str]) -> bool:
    try:
        stripped = strip_wrappers(command)
    except UnresolvableCommand:
        return True
    if not stripped:
        return False
    name = _base(stripped[0])
    if name == "find":
        return _find_deleting(stripped)
    return name == "rsync" and any(word.startswith("--delete") or word == "--remove-source-files" for word in stripped)


def _find_deleting(words: list[str]) -> bool:
    parts = _find_parts(words)
    return parts.deletes or any(body and _deletes_files(body) for _, body in parts.executions)


# The command that find runs is checked like a typed one. Its {} stands for the match: a whole {} is no operand of its own (the
# folders find starts in are the targets), and a path built from it is refused. -execdir runs in the folder of each match,
# which is not known here.
# A shell that is handed a name by find or xargs (`sh {}`, `xargs sh`) runs that file as a script, and which file it is is not
# known here; with a command string (-c) the names are only arguments.
def _shell_gets_a_name(command: list[str], marker: str, appended: bool) -> bool:
    try:
        stripped = strip_wrappers(command)
    except UnresolvableCommand:
        return False
    if not stripped or _base(stripped[0]) not in SHELLS:
        return False
    fish = _base(stripped[0]) == "fish"
    options, operands = _shell_words(stripped[1:], fish)
    if any(_is_command_option(option, fish) for option in options):
        return False
    # The shells disagree about which words are the values of options, so the marker counts wherever it stands.
    if any(marker in word for word in stripped[1:]):
        return True
    # A `-s` that no `+s` clears makes the shell read its input; otherwise an appended name becomes its script.
    reads_input = any(option[0] == "-" and "s" in _bundle_letters(option, fish) for option in options) and not any(
        option[0] == "+" and "s" in _bundle_letters(option, fish) for option in options
    )
    return appended and not operands and not reads_input


def _is_short(option: str) -> bool:
    return not option.startswith("--") and option not in BASH_SINGLE_DASH_LONG


# The letters that take the next word as their value (an attached value follows the letter inside the same word).
def _value_letters(fish: bool) -> str:
    return "CdDfoOP" if fish else "oO"


# The option letters of a short bundle up to the one that takes a value: the rest of the word is that value, not more options.
def _bundle_letters(option: str, fish: bool) -> str:
    if not _is_short(option):
        return ""
    letters = option[1:]
    for position, letter in enumerate(letters):
        if letter in _value_letters(fish):
            return letters[:position]
    return letters


# `c` selects a command string, as a letter of a short bundle or as fish's `--command`; `C` is bash's noclobber (and fish's
# initial command, after which the script is still read), and the single-dash long names of bash (`-norc`) only contain letters.
def _is_command_option(option: str, fish: bool) -> bool:
    return option == "--command" or option.startswith("--command=") or (option[0] == "-" and "c" in _bundle_letters(option, fish))


# The words after a shell's name split into options (each option that takes a separate value is followed by one word that is set
# aside) and operands: the script and its arguments, where the options end.
def _shell_words(words: list[str], fish: bool) -> tuple[list[str], list[str]]:
    options: list[str] = []
    operands: list[str] = []
    index = 0
    while index < len(words):
        word = words[index]
        index += 1
        if word == "--":
            operands.extend(words[index:])
            break
        if len(word) > 1 and word[0] in "-+":
            options.append(word)
            if word in SHELL_LONG_WITH_VALUE or (_is_short(word) and _value_is_next(word, fish)):
                index += 1
        else:
            operands.extend(words[index - 1 :])
            break
    return options, operands


# A letter that takes a value is the last one of its word when the value is the next word; otherwise it is attached.
def _value_is_next(option: str, fish: bool) -> bool:
    letters = option[1:]
    for position, letter in enumerate(letters):
        if letter in _value_letters(fish):
            return position == len(letters) - 1
    return False


def _moves_and_deletes(command: list[str]) -> bool:
    try:
        stripped, directories = strip_wrappers_with_directory(command)
    except UnresolvableCommand:
        return False
    return bool(directories) and bool(stripped) and _deletes_files(stripped)


def _find(words: list[str], cwd: str | None) -> None:
    parts = _find_parts(words)
    deleting = parts.deletes or any(body and _deletes_files(body) for _, body in parts.executions)
    for predicate, body in parts.executions:
        command = [argument.replace("{}", MATCH_MARK) for argument in body if argument != "{}"]
        if command:
            if _shell_gets_a_name(body, "{}", False):
                raise Denied(message("delete_guard.reason.match_path", verb="a shell", raw="{}"))
            # A wrapper that moves to another folder reads the name find gives it from there, which is not the folder it was found in.
            if "{}" in body and _moves_and_deletes(body):
                raise Denied(message("delete_guard.reason.match_path", verb="a command in another folder", raw="{}"))
            if _deletes_from_names(command):
                raise Denied(message("delete_guard.reason.xargs_rm"))
            # What find runs reads the standard input find was given, opened in the folder find runs in.
            _check_chunk(command, None if predicate in {"-execdir", "-okdir"} else cwd, " ".join(command), trusted=False)
    if not deleting:
        return
    if parts.input_roots:
        raise Denied(message("delete_guard.reason.find_roots"))
    follow = {"-L"} | ({"-H"} if _REMOTE[0] is not None else set())
    option = next((word for word in parts.global_follow if word in follow), "-follow" if parts.follows else None)
    if option:
        raise Denied(message("delete_guard.reason.find_follow", option=option))
    for start in parts.starts or ["."]:
        _check_target(start, cwd, recursive=True, verb="find -delete")


# The names xargs is given are not known, so a command that deletes them is refused, and so is a find or an rsync that would
# take its starting folders from them; anything else is checked as typed, with the replace string standing for an unknown name.
def _xargs(words: list[str], cwd: str | None) -> None:
    rest = words[1:]
    replace = None
    keeps_input = False
    while rest and rest[0].startswith("-") and len(rest[0]) > 1 and rest[0] != "--":
        option = rest[0]
        consumed = 1
        if option.startswith("--"):
            name, equals, value = option.partition("=")
            candidates = [full for full in XARGS_LONG_OPTIONS if full == name[2:]] or [full for full in XARGS_LONG_OPTIONS if full.startswith(name[2:])]
            if len(candidates) != 1:
                raise Denied(message("delete_guard.reason.xargs_option"))
            resolved = candidates[0]
            if resolved == "replace":
                replace = value if equals else "{}"
            elif XARGS_LONG_OPTIONS[resolved] == "required" and not equals:
                consumed = 2
            keeps_input = keeps_input or resolved in {"arg-file", "open-tty"}
        else:
            letters = option[1:]
            for position, letter in enumerate(letters):
                attached = letters[position + 1 :]
                if letter in {"i", "e", "l"}:
                    if letter == "i":
                        replace = attached or "{}"
                    break
                if letter in XARGS_SHORT_VALUES:
                    value = attached or (rest[1] if len(rest) > 1 else "")
                    consumed = 1 if attached else 2
                    if letter == "I":
                        replace = value
                    keeps_input = keeps_input or letter == "a"
                    break
                keeps_input = keeps_input or letter == "o"
        rest = rest[consumed:]
    if rest[:1] == ["--"]:
        rest = rest[1:]
    if not rest:
        return
    stripped = strip_wrappers(rest)
    if not stripped:
        return
    if _deletes_files(stripped) or _deletes_from_names(stripped):
        raise Denied(message("delete_guard.reason.xargs_rm"))
    marker = replace or "{}"
    if _shell_gets_a_name(rest, marker, True):
        raise Denied(message("delete_guard.reason.match_path", verb="a shell", raw=marker))
    command = [argument.replace(marker, MATCH_MARK) for argument in rest if argument != marker]
    # The children get /dev/null for input, unless the names come from a file and the input stays theirs.
    outer_files = _STDIN_FILES[0]
    if not keeps_input:
        _STDIN_FILES[0] = []
    try:
        _check_chunk(command, cwd, " ".join(command), trusted=False)
    finally:
        _STDIN_FILES[0] = outer_files


# A script is reviewed when its bytes are exactly those of the file in the last commit. The index is not asked, because
# its change flags (assume-unchanged, skip-worktree) can say "unchanged" for a file that was edited.
def _is_reviewed_script(path: str, data: bytes) -> bool:
    root = _repository_root(os.path.dirname(path))
    if root is None or GIT_PATH is None or not _inside(path, root):
        return False
    try:
        committed = subprocess.run(
            [GIT_PATH, "-C", root, "cat-file", "blob", "HEAD:" + os.path.relpath(path, root)],
            stdin=subprocess.DEVNULL, capture_output=True, timeout=3, check=False, env={"PATH": "/usr/bin:/bin", "HOME": USER_HOME, "LC_ALL": "C"},
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    return committed.returncode == 0 and committed.stdout == data


# Startup files hold keys and aliases and are never read or shown, so a denial message cannot quote one.
def _script_excluded(path: str) -> bool:
    return (os.path.dirname(path) == USER_HOME and os.path.basename(path).startswith(".")) or any(_inside(path, root) for root in ETC_PATHS)


# Opening without waiting means a pipe or a device can never stall the check, and the descriptor is what is examined.
def _read_regular_file(path: str, limit: int) -> bytes | None:
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
    except OSError:
        return None
    try:
        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
            return None
        chunks: list[bytes] = []
        remaining = limit + 1
        while remaining > 0:
            data = os.read(descriptor, min(remaining, 65536))
            if not data:
                break
            chunks.append(data)
            remaining -= len(data)
        return b"".join(chunks)
    except OSError:
        return None
    finally:
        os.close(descriptor)


# The body of a quoted here-document that cat only prints is text, not commands.
def _without_text_heredocs(text: str) -> str:
    pieces: list[str] = []
    position = 0
    for document in heredocs(text):
        if document.outer is not None or not document.quoted or document.body_start < position:
            continue
        head = re.split(r"&&|\|\||;|\||&", text[document.line_start : document.marker_start])[-1]
        if TEXT_HEREDOC_OWNER.fullmatch(head) and not TEXT_HEREDOC_TAIL.search(text[document.delimiter_end : document.line_end]):
            pieces.append(text[position : document.body_start])
            position = document.end
    pieces.append(text[position:])
    stripped = "".join(pieces)
    return text if HEREDOC_FORBIDDEN.search(stripped) else stripped


# A script nobody has reviewed (not tracked, or changed since the last commit) is read before it runs and its deletes are
# held to the same rules as a typed command, because its variables and loops hide what a quick look at the command cannot.
def _check_script(raw: str, cwd: str | None, *, shell: bool) -> None:
    # A name with braces or wildcards stands for several files; each is read, since which of them is the script and which an
    # argument is not worth following.
    # The words reach this check with their quotes removed, so a name that is a pattern may be a file with that very name
    # (`'danger[1].sh'`); it is read as written as well.
    _check_script_file(raw, cwd, shell=shell)
    if ("{" in raw and BRACE_PATTERN.search(raw)) or re.search(r"[*?\[]", raw):
        variants = expand_braces(raw)
        if variants is None:
            raise Denied(message("delete_guard.reason.expansion", verb="script", raw=raw))
        for variant in variants:
            for name in _glob_matches(variant, cwd, "script") or ([variant] if not re.search(r"[*?\[]", variant) else []):
                _check_script_file(name, cwd, shell=shell)


def _check_script_file(raw: str, cwd: str | None, *, shell: bool) -> None:
    resolved = _expand(raw, cwd)
    if resolved is None or resolved in _SCRIPT_STACK or len(_SCRIPT_STACK) >= MAX_SCRIPT_DEPTH or _script_excluded(resolved):
        return
    data = _read_regular_file(resolved, MAX_SCRIPT_BYTES)
    if data is None or len(data) > MAX_SCRIPT_BYTES or b"\x00" in data[:1024]:
        return
    text = data.decode("utf-8", errors="replace")
    if not (shell or SHELL_SHEBANG.match(text)):
        return
    try:
        status = os.stat(resolved)
    except OSError:
        return
    key = (resolved, status.st_size, status.st_mtime_ns, cwd, tuple(_STDIN_FILES[0]))
    if _SCRIPT_CACHE.get(key):
        return
    if _is_reviewed_script(resolved, data):
        _SCRIPT_CACHE[key] = True
        return
    _SCRIPT_STACK.append(resolved)
    try:
        _check_command(_without_text_heredocs(text), cwd)
    except Denied as denial:
        raise type(denial)(message("delete_guard.reason.in_script", script=resolved, reason=str(denial))) from None
    finally:
        _SCRIPT_STACK.pop()
    _SCRIPT_CACHE[key] = True


def _search_path(name: str) -> str | None:
    found = shutil.which(name, path=os.pathsep.join((os.environ.get("PATH", ""), os.path.join(USER_HOME, ".local", "bin"))))
    return os.path.realpath(found) if found else None


# The lines of a here-document are text for some command, not commands of the script.
def _without_heredoc_bodies(text: str) -> str:
    pieces: list[str] = []
    position = 0
    for document in heredocs(text):
        if document.outer is None and document.body_start >= position:
            pieces.append(text[position : document.body_start])
            position = document.end
    pieces.append(text[position:])
    return "".join(pieces)


# The checker counts when a command of the script runs it, also inside a substitution; a mention in a string, a comment or
# an assignment does not.
def _runs_checker(text: str, depth: int) -> bool:
    if depth > MAX_SCRIPT_DEPTH or VETTED_MENTION.search(text) is None:
        return False
    text = _without_heredoc_bodies(text)
    if any(_runs_checker(body, depth + 1) for body in command_substitutions(text)):
        return True
    chunks = _tokenize(text)
    for chunk in chunks or []:
        try:
            words = strip_wrappers(chunk.words)
        except UnresolvableCommand:
            continue
        if len(words) > 1 and _base(words[0]) == "delete-guard" and words[1] in VETTED_COMMANDS:
            return True
    return False


@functools.lru_cache(maxsize=32)
def _vets_deletes(path: str | None) -> bool:
    if path is None or _script_excluded(path):
        return False
    data = _read_regular_file(path, 65536)
    return data is not None and _runs_checker(data[:65536].decode("utf-8", errors="replace"), 0)


# ssh and mosh take options before the host and again after it; an option this reader does not know ends in a refusal,
# because guessing where the host is could hide the command that follows it.
def _remote_command_words(name: str, words: list[str]) -> list[str]:
    rest = words[1:]
    if name not in REMOTE_COMMAND_NAMES:
        return rest
    mosh = name == "mosh"
    flags = MOSH_FLAG_LETTERS if mosh else SSH_FLAG_LETTERS
    values = MOSH_VALUE_LETTERS if mosh else SSH_VALUE_LETTERS
    host = False
    index = 0
    while index < len(rest):
        word = rest[index]
        if word == "--":
            index += 1
            if not host and index < len(rest):
                index += 1
            return rest[index:]
        if mosh and word.startswith("--"):
            option = word.split("=", 1)[0]
            if option in MOSH_LONG_VALUES:
                index += 1 if "=" in word else 2
            elif option in MOSH_LONG_FLAGS:
                index += 1
            else:
                raise Denied(message("delete_guard.reason.unparseable"))
        elif word.startswith("-") and len(word) > 1:
            takes_next = False
            for position in range(1, len(word)):
                if word[position] in values:
                    takes_next = position + 1 >= len(word)
                    break
                if word[position] not in flags:
                    raise Denied(message("delete_guard.reason.unparseable"))
            index += 2 if takes_next else 1
        elif not host:
            host = True
            index += 1
        else:
            return rest[index:]
    return []


def _check_remote_command(text: str) -> None:
    previous = _REMOTE[0]
    _REMOTE[0] = _remote_roots()
    try:
        # The words a shell hands on have lost their quotes by now, but a quoted or escaped tilde is not expanded on the
        # other side, so it stands for a folder named ~ and not for the home folder.
        if (QUICK_SCAN.search(text) or QUICK_SCAN.search(QUOTE_CHARACTERS.sub("", text))) and QUOTED_TILDE.search(text):
            raise RemoteDenied(message("delete_guard.reason.remote_target", verb="delete", raw="a quoted or escaped ~"))
        _check_command(text, None)
    finally:
        _REMOTE[0] = previous


def _check_rsync_operand(operand: str, cwd: str | None, verb: str) -> None:
    if re.match(r"[^/\s]+:", operand):
        raise Denied(message("delete_guard.reason.rsync_remote"))
    _check_target(operand, cwd, recursive=True, verb=verb)


# --delete removes from the destination and --remove-source-files from the sources, so each is held to the target rules.
def _rsync(words: list[str], cwd: str | None) -> None:
    deleting = any(word.startswith("--delete") for word in words)
    removing = "--remove-source-files" in words
    if not (deleting or removing):
        return
    operands = split_options(words[1:], RSYNC_VALUE_LETTERS, RSYNC_VALUE_OPTIONS)
    if not operands:
        return
    if deleting:
        _check_rsync_operand(operands[-1], cwd, "rsync --delete")
    if removing:
        for source in operands[:-1]:
            _check_rsync_operand(source, cwd, "rsync --remove-source-files")


# The folder a wrapper such as `env -C` or `sudo -D` runs its command in, or None when it cannot be told from the text.
def _wrapper_directory(value: str, base: str | None) -> str | None:
    if not value or _is_computed(value):
        return None
    resolved = _expand(value, base)
    return resolved if resolved is not None and os.path.isdir(resolved) else None


# Wrappers inside wrappers each move from the folder the one before left; after a root change nothing can be resolved here.
def _wrapper_directories(values: list[str], start: str | None) -> str | None:
    folder, lost = start, False
    for value in values:
        lost = lost or not value
        folder = None if lost else _wrapper_directory(value, folder)
    return folder


# The result is the shell's folder after the command and whether this command was a directory change that is known.
# The files a command line opens are opened in the folder of its shell, before any wrapper moves: while one of its commands
# is checked, the files of that line that have no folder yet are given the folder of the shell, so whatever the command runs
# (a wrapper, find, xargs, `sh -c`, eval, a script) looks for them there.
def _check_chunk(words: list[str], cwd: str | None, command_text: str, trusted: bool = True) -> tuple[str | None, bool]:
    held = _STDIN_FILES[0]
    _STDIN_FILES[0] = [(name, cwd if folder is None else folder) for name, folder in held]
    try:
        return _check_one_chunk(words, cwd, command_text, trusted)
    finally:
        _STDIN_FILES[0] = held


def _check_one_chunk(words: list[str], cwd: str | None, command_text: str, trusted: bool = True) -> tuple[str | None, bool]:
    try:
        stripped, directories = strip_wrappers_with_directory(words)
    except UnresolvableCommand:
        # A command with no delete word in it was never looked at before, so an odd wrapper there is not a reason to refuse.
        if QUICK_SCAN.search(command_text):
            raise Denied(message("delete_guard.reason.unparseable"))
        return cwd, False
    if not stripped:
        return cwd, False
    wrapped = len(stripped) != len(words)
    words = stripped
    # A wrapper that changes directory only affects its own command, so the shell's folder is restored afterwards.
    shell_cwd = cwd
    if directories:
        cwd = _wrapper_directories(directories, cwd)
    name = _base(words[0])
    if name == "popd":
        return None, False
    if name in {"cd", "pushd"}:
        if wrapped or _REMOTE[0] is not None:
            return None, False
        targets = [word for word in words[1:] if word == "-" or not word.startswith("-")]
        if not targets:
            return (USER_HOME, True) if trusted else (None, False)
        if len(targets) > 1:
            return None, False
        target = targets[0]
        if target == "-" or _is_computed(target):
            return None, False
        # CDPATH makes a relative name a name inside one of its folders.
        if not target.startswith(("/", "./", "../", "~", "$")) and target not in {".", ".."} and ("CDPATH" in command_text or os.environ.get("CDPATH")):
            return None, False
        resolved = _expand(target, cwd)
        # A cd that may be skipped, grouped, backgrounded or failed leaves the real folder unknown.
        if not trusted or resolved is None or not os.path.isdir(resolved):
            return None, False
        return resolved, True
    if name in SHELLS:
        _check_shell(words, cwd)
        return shell_cwd, False
    if name in {"source", "."} and len(words) > 1 and _REMOTE[0] is None:
        _check_script(words[1], cwd, shell=True)
        return shell_cwd, False
    # A wrapper is the file the shell would run, so a relative name is resolved against the folder the command runs in.
    wrapper = None
    if name.endswith(".sh"):
        wrapper = _expand(words[0], cwd) if "/" in words[0] else _search_path(words[0])
    vetted = _vets_deletes(wrapper)
    if name in REMOTE_COMMAND_NAMES or REMOTE_COMMAND_PATTERN.fullmatch(name) or name in _configured_remote_names() or vetted:
        text = " ".join(_remote_command_words(name, words))
        # A vetted wrapper judges the expanded text itself when it runs, so a variable here is left to it.
        if text and not (vetted and re.search(r"[$`]", text)):
            _check_remote_command(text)
        if vetted and _REMOTE[0] is None:
            _check_script(wrapper, cwd, shell=False)
        return shell_cwd, False
    if name == "eval":
        _check_command(" ".join(words[1:]), cwd)
        return shell_cwd, False
    heredoc = command_text.split("<<", 1)[1] if "<<" in command_text else ""
    if name.rstrip("0123456789.") in INTERPRETERS:
        if INLINE_RECURSIVE_DELETE.search(" ".join(words[1:])) or INLINE_RECURSIVE_DELETE.search(heredoc):
            raise Denied(message("delete_guard.reason.inline_delete"))
        if name == "osascript" and FINDER_TEXT.search(" ".join(words[1:]) + "\n" + heredoc):
            raise Denied(message("delete_guard.reason.trash_empty", name=name))
    if name in {"rm", "unlink", "rmdir"}:
        _rm(words, cwd)
    elif name in TRASH_TOOLS:
        _trash(words, cwd)
    elif TRASH_EMPTY_TOOL.fullmatch(name):
        raise Denied(message("delete_guard.reason.trash_empty", name=name))
    elif KDE_TRASH_TOOL.fullmatch(name):
        if any(word.split("=", 1)[0] == "--empty" for word in words[1:]):
            raise Denied(message("delete_guard.reason.trash_empty", name=name))
    elif name == "gvfs-rm":
        for operand in split_options(words[1:], "", frozenset()):
            _check_target(_location_path(operand, "gvfs-rm"), cwd, recursive=False, verb="gvfs-rm")
    elif KIO_TOOL.fullmatch(name):
        operands = split_options(words[1:], "", frozenset())
        verb = _kio_command(words)
        if verb in KIO_REMOVE_VERBS:
            for operand in operands[operands.index(verb) + 1 :]:
                _check_target(_location_path(operand, "kioclient " + verb), cwd, recursive=True, verb="kioclient " + verb)
    elif name in {"hadoop", "hdfs"}:
        if HADOOP_PURGE_OPTIONS & set(words[1:]):
            raise Denied(message("delete_guard.reason.trash_empty", name=name))
    elif name.lower() == "clear-recyclebin" or (name.lower() in WINDOWS_SHELLS and WINDOWS_TEXT.search(" ".join(words[1:]) + "\n" + heredoc)):
        raise Denied(message("delete_guard.reason.trash_empty", name=name))
    elif name == "find":
        _find(words, cwd)
    elif name == "xargs":
        _xargs(words, cwd)
    elif name == "rsync":
        _rsync(words, cwd)
    elif ERASE_TOOL.fullmatch(name):
        raise Denied(message("delete_guard.reason.erase_tool", name=name))
    elif name == "diskutil" and any(DISKUTIL_ERASE.match(word) for word in words[1:]):
        raise Denied(message("delete_guard.reason.diskutil"))
    elif name == "dd":
        for word in words[1:]:
            if word.startswith("of="):
                if _is_computed(word[3:]):
                    raise Denied(message("delete_guard.reason.computed_path", verb="dd", raw=word[3:]))
                resolved = _expand(word[3:], cwd)
                if resolved is None or _inside(resolved, "/dev"):
                    raise Denied(message("delete_guard.reason.dd_device"))
    elif name == "gio":
        _gio(words, cwd)
    elif name == "git":
        _git_clean(words)
    elif _REMOTE[0] is None and "/" in words[0] and not (os.path.isabs(words[0]) and words[0].startswith(SYSTEM_PROGRAM_FOLDERS)):
        _check_script(words[0], cwd, shell=False)
    elif _REMOTE[0] is None and wrapper:
        _check_script(wrapper, cwd, shell=False)
    return shell_cwd, False


# The files the command line opens for reading, for a shell on the line that reads its standard input. Which of them is the
# input depends on descriptors and groups, so every one is read as a possible script; a data file that holds a delete can be
# refused. A command run by xargs without an argument file gets /dev/null, so it has none.
_STDIN_FILES: list[list[tuple[str, str | None]]] = [[]]


# The places the command line writes to with a redirection (`> /dev/disk3`), for those that are devices. The pseudo files of bash
# (`/dev/tcp/host/port`) and the terminals and sinks that every command writes to are not devices to protect.
DEVICE_WRITE_OK = re.compile(r"/dev/(?:null|zero|full|stdout|stderr|stdin|tty\w*|console|random|urandom|ptmx|(?:fd|pts|shm|tcp|udp)/.*)")
# In a command too large to read, only a redirection that names a device is looked for.
DEVICE_REDIRECT_HINT = re.compile(
    r"(?:>|<>)&?!?\s*/dev/(?!(?:null|zero|full|stdout|stderr|stdin|tty\w*|console|random|urandom|ptmx)(?![\w./-])|(?:fd|pts|shm|tcp|udp)/)"
)
FILE_DESCRIPTOR_OPERAND = re.compile(r"\d+-?|-")


# `>&2` and `>&-` duplicate or close a descriptor; `>&file` and `<>` write a file as `>` does.
def _writes_a_file(operator: str, operand: str) -> bool:
    if operand.startswith("("):
        return False
    if operator == ">&":
        return FILE_DESCRIPTOR_OPERAND.fullmatch(operand) is None
    return operator.startswith((">", "<>"))


# The names a redirection word stands for: the word, each brace variant, and what a pattern matches. A quoted or escaped
# wildcard or brace is part of the name, so `operand` (the text as written) tells which characters are active.
def _redirection_names(word: str, operand: str, cwd: str | None) -> list[str]:
    active = unquoted_text(operand)
    variants = [word]
    if "{" in active and BRACE_PATTERN.search(active):
        variants = expand_braces(word)
        if variants is None:
            raise Denied(message("delete_guard.reason.expansion", verb="a redirection", raw=word))
    names: list[str] = []
    for variant in variants:
        names.append(variant)
        if re.search(r"[*?\[]", active):
            names.extend(_glob_matches(variant, cwd, "a redirection"))
    return names


# A redirection is opened by the shell that reads the command line, in the folder it is in at that point, before any wrapper of
# the command (`env -C dir`) moves.
def _check_device_writes(redirections: tuple[tuple[str, str, str], ...], cwd: str | None) -> None:
    for _, operator, operand in redirections:
        if not _writes_a_file(operator, operand):
            continue
        try:
            words = shlex.split(operand)
        except ValueError:
            continue
        if not words or not words[0]:
            continue
        if _is_computed(words[0]):
            if "/dev" in words[0] and words[0].startswith(("/dev/", "$")):
                raise Denied(message("delete_guard.reason.computed_path", verb="a redirection", raw=words[0]))
            continue
        for name in _redirection_names(words[0], operand, cwd):
            # The place the name leads to decides: a link in /dev/shm can lead to a device.
            resolved = _expand(name, cwd)
            if resolved is None:
                continue
            if _inside(resolved, "/dev") and not DEVICE_WRITE_OK.fullmatch(resolved):
                raise Denied(message("delete_guard.reason.device_redirect", path=resolved))


def _line_input_files(command: str) -> list[tuple[str, str | None]]:
    redirects: list[tuple[str, str, str]] = []
    normalize_command(command, redirects)
    names: list[tuple[str, str | None]] = []
    for _, operator, operand in redirects:
        if operator in STDIN_OPERATORS:
            try:
                words = shlex.split(operand)
            except ValueError:
                continue
            if words:
                names.append((words[0], None))
    return names


# Bash, zsh, fish and dash disagree about which options take a value, how a sign changes a letter and whether a long option
# has one dash or two, so the options are not parsed. Every word that is not an option is read as a possible script, and when an
# option can mean a command string (a `c`, `C` or `command` in a dashed word) it is checked as command text too; text inside
# an option word (`--command='cmd'`, `-c'cmd'`) is checked as well. The input files are read when no word can be a script or an
# `s` appears in an option. This reads more files than the shell does (an argument that names a script is read as one).
def _check_shell(words: list[str], cwd: str | None) -> None:
    options: list[str] = []
    operands: list[str] = []
    for index, word in enumerate(words[1:], 1):
        if word == "--":
            operands.extend(words[index + 1 :])
            break
        if len(word) > 1 and word[0] in "-+":
            options.append(word)
        else:
            operands.append(word)
    command_options = [option for option in options if "command" in option or (not option.startswith("--") and ("c" in option or "C" in option))]
    for option in options:
        if option in command_options or re.search(r"[\s;|&=]", option):
            # The text may start after the letters of the option (`-c'cmd'`, `--command=cmd`), wherever they end.
            prefix = re.match(r"[-+]+[A-Za-z-]{0,40}=?", option).group(0)
            for cut in range(1, len(prefix) + 1):
                _check_command(option[cut:], cwd)
    if command_options:
        for operand in operands:
            _check_command(operand, cwd)
    if _REMOTE[0] is not None:
        return
    for operand in operands:
        _check_script(operand, cwd, shell=True)
    if not operands or any(not option.startswith("--") and "s" in option for option in options):
        for name, folder in _STDIN_FILES[0]:
            _check_script(name, folder, shell=True)


# Ignored files hold machine-local notes and archives, so a real `git clean` run is never automatic.
def _git_clean(words: list[str]) -> None:
    index = 1
    while index < len(words) and words[index].startswith("-"):
        index += 2 if words[index] in GIT_VALUE_OPTIONS else 1
    if index >= len(words) or words[index] != "clean":
        return
    dry_run = False
    position = index + 1
    while position < len(words) and words[position] != "--":
        option = words[position]
        position += 1
        if option.startswith("--"):
            name = option.split("=", 1)[0]
            if name == "--dry-run":
                dry_run = True
            elif name == "--no-dry-run":
                dry_run = False
            elif name == "--exclude" and "=" not in option:
                position += 1
        elif option.startswith("-") and len(option) > 1:
            letters = option[1:]
            for offset, letter in enumerate(letters):
                if letter == "n":
                    dry_run = True
                elif letter == "e":
                    if offset == len(letters) - 1:
                        position += 1
                    break
    if not dry_run:
        raise Denied(message("delete_guard.reason.git_clean"))


def _configured_remote_names() -> frozenset[str]:
    return frozenset(name for name in re.split(r"[:,\s]+", os.environ.get("AGENT_SAFEGUARDS_REMOTE_COMMANDS", "")) if name)


QUOTE_CHARACTERS = re.compile(r"[\\'\"]")


def _check_command(command: str, cwd: str | None) -> None:
    # What a quoted here-document prints is text; a redirection in it is not opened.
    if "<<" in command:
        command = _without_text_heredocs(command)
    # A name split by empty quotes (`r""m`, `""bash`) is one word to the shell, so the gates look at the text without quotes too.
    bare = QUOTE_CHARACTERS.sub("", command)
    delete_words = QUICK_SCAN.search(command) is not None or QUICK_SCAN.search(bare) is not None
    configured = any(
        re.search(r"(?:^|[\s;&|(])" + re.escape(name) + r"(?:\s|$)", text) for name in _configured_remote_names() for text in (command, bare)
    )
    writes = ">" in command
    if not (delete_words or writes or SCRIPT_HINT.search(command) or SCRIPT_HINT.search(bare) or configured):
        return
    if len(command) > MAX_COMMAND_CHARS:
        if delete_words or DEVICE_REDIRECT_HINT.search(bare):
            raise Denied(message("delete_guard.reason.too_large"))
        return
    # A substitution can run from anywhere in the command, so its body is checked on its own, from an unknown
    # folder whenever the command also changes directory.
    substitution_cwd = None if re.search(r"\b(?:cd|pushd|popd)\b", command) else cwd
    # A command line inside another (a substitution, `sh -c`, `eval`, a script) reads the input of the line around it as well.
    outer_files = _STDIN_FILES[0]
    _STDIN_FILES[0] = outer_files + _line_input_files(command)
    outer_home = _HOME_CHANGED[0]
    _HOME_CHANGED[0] = outer_home or HOME_ASSIGNMENT.search(command) is not None
    try:
        for body in command_substitutions(command):
            if body.strip():
                _check_command(body, substitution_cwd)
        _check_chunks(command, cwd)
    finally:
        _STDIN_FILES[0] = outer_files
        _HOME_CHANGED[0] = outer_home


def _check_chunks(command: str, cwd: str | None) -> None:
    chunks = _tokenize(command)
    if chunks is None:
        # The command cannot be split, but the redirections in it can still be read where they stand.
        recorded: list[tuple[str, str, str]] = []
        normalize_command(command, recorded)
        _check_device_writes(tuple(recorded), os.path.realpath(cwd) if cwd else None)
        if INLINE_RECURSIVE_DELETE.search(command) or re.search(r"-delete\b", command):
            raise Denied(message("delete_guard.reason.unparseable"))
        return
    current = os.path.realpath(cwd) if cwd else None
    grouped = False
    previous_cd_known = False
    conditional = False
    for chunk in chunks:
        grouped = grouped or chunk.opened
        if chunk.redirections:
            _check_device_writes(chunk.redirections, None if conditional and chunk.before != "&&" else current)
        if not chunk.words:
            continue
        # A folder learned after && holds only while the commands keep chaining with &&; anything else may still run.
        if conditional and chunk.before != "&&":
            current, conditional = None, False
        # A cd after && only runs if the command before it worked. It is trusted after a known cd, or when the
        # next command also waits on it with &&, so skipping it can never leave a later command in the wrong folder.
        reached = chunk.before in {None, ";"} or (
            chunk.before == "&&" and (previous_cd_known or chunk.after == "&&")
        )
        # A failed redirection stops its cd, so a redirected cd is trusted only when && keeps the next command waiting on it.
        trusted = (
            not grouped
            and (not chunk.redirected or chunk.after == "&&")
            and chunk.words[0] not in SHELL_KEYWORDS
            and reached
            and chunk.after in {None, ";", "&&"}
        )
        current, previous_cd_known = _check_chunk(chunk.words, current, command, trusted)
        if previous_cd_known and chunk.before == "&&" and chunk.after == "&&":
            conditional = True


def _run_hook() -> int:
    try:
        raw = sys.stdin.buffer.read(MAX_INPUT_BYTES + 1)
        if len(raw) > MAX_INPUT_BYTES:
            raise ValueError
        payload = json.loads(raw)
        if not isinstance(payload, dict):
            raise ValueError
    except Exception:
        emit_decision("deny", message("delete_guard.deny_input"))
        return 0
    tool_input = payload.get("tool_input")
    command = tool_input.get("command") if isinstance(tool_input, dict) else None
    if not isinstance(command, str):
        return 0
    cwd = payload.get("cwd") if isinstance(payload.get("cwd"), str) else None
    workdir = tool_input.get("workdir")
    if isinstance(workdir, str) and workdir:
        cwd = workdir if os.path.isabs(workdir) or cwd is None else os.path.join(cwd, workdir)
    try:
        _run_with_budget(lambda: _check_command(command, cwd))
    except Denied as denial:
        _emit_deny(denial)
    except CheckTooSlow:
        if not fail_open():
            emit_decision("deny", message("delete_guard.deny_too_slow"))
    except Exception:
        if not fail_open():
            emit_decision("deny", message("delete_guard.deny_internal"))
    return 0


def _check_remote_cli(command: str) -> int:
    try:
        _run_with_budget(lambda: _check_remote_command(command))
    except Denied as denial:
        sys.stderr.write(message("delete_guard.deny_remote", reason=str(denial), roots=", ".join(_remote_roots())) + "\n")
        return 1
    except CheckTooSlow:
        sys.stderr.write(message("delete_guard.deny_too_slow") + "\n")
        return 1
    except Exception:
        sys.stderr.write(message("delete_guard.deny_internal") + "\n")
        return 1
    return 0


# A lexical rule cannot see a link inside an allowed folder that leads out of it, so the machine itself resolves each
# permanent delete target (its folder, so that deleting a link itself stays possible) and must find it inside a root.
# The shell patterns of the folder names that make a path part of a Trash, for the machine to match its resolved path against.
def _preflight_trash_patterns() -> str:
    def folded(name: str) -> str:
        return "".join("[%s%s]" % (letter.lower(), letter.upper()) if letter.isalpha() else letter for letter in name)

    components = [
        folded(".Trash"), folded(".Trash") + "-*", folded(".Trashes"), "\\$" + folded("Recycle.Bin"), "#" + folded("recycle"), "@" + folded("Recycle"),
        folded("files_trashbin"), "RECYCLER", "RECYCLED", "Recycled", ".recycle", ".FilesByGoogleTrash", ".trashed-*",
    ]
    patterns = ["*/" + component + suffix for component in components for suffix in ("", "/*")]
    patterns += ["*/.local/share/Trash", "*/.local/share/Trash/*", "/boot/trash", "/boot/trash/*"]
    return "|".join(patterns)


def _remote_preflight_script() -> str:
    targets = list(dict.fromkeys(_REMOTE_TARGETS))
    roots = _remote_roots()
    if not targets or not roots:
        return ""
    removed = " ".join(path for path, entered in targets if not entered)
    entered = " ".join(path for path, entered in targets if entered)
    return (
        "fail=0; check() { case \"$1\" in " + _preflight_trash_patterns() + ") echo \"PREFLIGHT_REFUSED $2\"; fail=1; return;; esac; "
        "ok=0; for root in " + " ".join(roots) + "; do rr=$(cd -P -- \"$root\" 2>/dev/null && pwd) || continue; "
        "case \"$1\" in \"$rr\"/?*) ok=1;; esac; done; "
        "[ \"$ok\" = 1 ] || { echo \"PREFLIGHT_REFUSED $2\"; fail=1; }; }; "
        "for t in " + removed + "; do d=$(dirname -- \"$t\"); b=$(basename -- \"$t\"); [ -d \"$d\" ] || continue; "
        "check \"$(cd -P -- \"$d\" && pwd)/$b\" \"$t\"; done; "
        "for t in " + entered + "; do [ -d \"$t\" ] || continue; check \"$(cd -P -- \"$t\" && pwd)\" \"$t\"; done; "
        "[ \"$fail\" = 0 ] && echo PREFLIGHT_OK"
    )


def _remote_preflight_cli(command: str) -> int:
    _REMOTE_TARGETS.clear()
    code = _check_remote_cli(command)
    if code == 0:
        script = _remote_preflight_script()
        if script:
            sys.stdout.write(script + "\n")
    return code


def _self_test() -> int:
    probe = _repository_root(os.getcwd()) or ""
    blocked = [
        "rm -rf ~/Documents",
        "rm -rf ~",
        "rm -rf /",
        "rm -rf /Users/x",
        '/bin/rm -rf "$WT"/',
        "rm -rf $HOME",
        "sudo rm -rf /opt/x",
        "cd ~ && rm -rf Documents",
        "cd ~\nrm -rf Documents",
        "find ~ -mindepth 1 -delete",
        "find ~/Documents -name x -exec rm -rf {} +",
        "find . -type f | xargs rm -f",
        "python3 -c 'import shutil; shutil.rmtree(\"/x\")'",
        "bash -lc 'rm -rf ~/Library'",
        "rm -rf /Volumes/Drive",
        "rm -rf /mnt/data",
        "diskutil eraseDisk APFS X disk4",
        "dd if=/dev/zero of=/dev/disk4",
        "trash ~/Documents",
        "gio trash ~/Documents",
        "rm -rf *",
        "rsync -a --delete src/ ~/Documents/",
        "git clean -fdx",
        "git -C /tmp/r clean -fd",
        "trash-empty",
        "gio trash --empty",
        "rm -rf ~/.Trash/old",
        "rm ~/.local/share/Trash/files/old",
        "trash ~/.local/share/Trash/files/old",
    ]
    allowed = [
        "rm -rf /private/tmp/agent-probe",
        "rm -rf /tmp/agent-probe/build",
        "rm -rf /var/tmp/agent-probe",
        "rm -f /tmp/x.log",
        "rmdir empty-dir",
        "trash /private/tmp/old",
        "trash-put /private/tmp/old",
        "gio trash /private/tmp/old",
        "git rm -r --cached x",
        "git worktree remove .worktrees/old",
        "find /tmp/x -name '*.log' -delete",
        "rg -n 'rm -rf' docs",
        "ls -la",
        "echo find this",
        "git clean -ndx",
        "git status --short",
    ]
    if probe:
        allowed.append(f"rm -rf {probe}/build/outputs")
        blocked.append(f"rm -rf {probe}")
        blocked.append(f"rm -rf {probe}/.git")
    failures = []
    for command in blocked:
        try:
            _check_command(command, probe or "/private/tmp")
            failures.append(f"allowed: {command!r}")
        except Denied:
            pass
    for command in allowed:
        try:
            _check_command(command, probe or "/private/tmp")
        except Denied as denial:
            failures.append(f"blocked: {command!r} ({denial})")
    status = "self_test_passed" if not failures else "self_test_failed"
    sys.stdout.write(json.dumps({"tool": TOOL_NAME, "status": status, "failures": failures, "repo_probe": bool(probe)}) + "\n")
    return 0 if not failures else 1


def main() -> int:
    if len(sys.argv) >= 2 and sys.argv[1] == "self-test":
        return _self_test()
    arguments = sys.argv[1:]
    if arguments[:1] == ["check-remote"] and len(arguments) == 2:
        return _check_remote_cli(arguments[1])
    if arguments[:1] == ["remote-preflight"] and len(arguments) == 2:
        return _remote_preflight_cli(arguments[1])
    if arguments[:1] == ["hook"] and 2 <= len(arguments) <= 3 and arguments[1] in {"claude", "codex"}:
        if len(arguments) == 2 or arguments[2] in HOOK_EVENTS:
            return _run_hook()
    sys.stderr.write(message("delete_guard.cli.usage") + "\n")
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
