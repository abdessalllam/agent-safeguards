# This result is module-level because every subprocess must cross the same bounded boundary.
@dataclass(frozen=True)
class _ProcessResult:
    returncode: int
    stdout: bytes
    stderr: bytes


def _environment() -> dict[str, str]:
    environment = {key: os.environ[key] for key in SAFE_ENV_KEYS if key in os.environ}
    environment["HOME"] = USER_HOME
    environment["LC_ALL"] = "C"
    environment["PATH"] = TRUSTED_PATH
    environment["TMPDIR"] = "/tmp"
    environment["XDG_CONFIG_HOME"] = os.path.join(USER_HOME, ".config")
    environment["XDG_DATA_HOME"] = os.path.join(USER_HOME, ".local", "share")
    environment["XDG_STATE_HOME"] = os.path.join(USER_HOME, ".local", "state")
    environment["GIT_PAGER"] = "cat"
    environment["GIT_TERMINAL_PROMPT"] = "0"
    environment["NO_COLOR"] = "1"
    return environment


def _run(command: list[str], *, cwd: str, timeout: int) -> _ProcessResult | None:
    try:
        completed = subprocess.run(
            command,
            cwd=cwd,
            env=_environment(),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
            timeout=timeout,
            start_new_session=True,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if len(completed.stdout) > MAX_OUTPUT_BYTES or len(completed.stderr) > MAX_OUTPUT_BYTES:
        return None
    return _ProcessResult(completed.returncode, completed.stdout, completed.stderr)


def _normalized(token: str) -> str:
    return os.path.basename(token).lower()


# Only the bare name or this exact installed file counts, so a look-alike script cannot borrow the exemption.
def _is_self(word: str) -> bool:
    if word == TOOL_NAME:
        return True
    if os.path.basename(word) != TOOL_NAME:
        return False
    expanded = re.sub(r"^(\$HOME|\$\{HOME\})", USER_HOME, word)
    if expanded.startswith("~/"):
        expanded = USER_HOME + expanded[1:]
    return os.path.realpath(expanded) == SELF_PATH


def _tokenize(command: str) -> list[list[str]]:
    try:
        lexer = shlex.shlex(normalize_command(command), posix=True, punctuation_chars=";&|()\n")
        lexer.whitespace = " \t\r"
        lexer.whitespace_split = True
        lexer.commenters = ""
        tokens = [token for token in lexer if token != REDIRECTION_MARKER]
    except ValueError:
        return []
    chunks: list[list[str]] = [[]]
    for token in tokens:
        if token and all(character in SHELL_PUNCTUATION for character in token):
            if chunks[-1]:
                chunks.append([])
            continue
        chunks[-1].append(token)
    return [chunk for chunk in chunks if chunk]


def _unwrap(words: list[str]) -> tuple[list[str], bool]:
    used_proxy = False
    words = strip_wrappers(words, frozenset({"rtk"}))
    if words and _normalized(words[0]) == "rtk":
        if len(words) > 1 and _normalized(words[1]) == "proxy":
            used_proxy = True
            words = words[2:]
        else:
            words = words[1:]
        words = strip_wrappers(words, frozenset({"rtk"}))
    return words, used_proxy


def _git_subcommand(words: list[str]) -> tuple[str | None, list[str]]:
    normalized = [_normalized(word) for word in words]
    try:
        index = normalized.index("git") + 1
    except ValueError:
        return None, []
    while index < len(words):
        argument = words[index]
        if argument in GIT_VALUE_OPTIONS:
            index += 2
            continue
        if argument.startswith("-"):
            index += 1
            continue
        return _normalized(argument), words[index + 1 :]
    return None, []


# Git applies the last format option, so only that one decides whether author details can print.
def _safe_history_arguments(arguments: list[str], *, show: bool) -> bool:
    effective: str | None = None
    for argument in arguments:
        if argument == "--":
            break
        lowered = argument.lower()
        if lowered == "--oneline":
            effective = "oneline"
        elif lowered.startswith(("--format=", "--pretty=")):
            effective = argument.split("=", 1)[1]
        elif lowered in {"--format", "--pretty"}:
            effective = "default"
    if effective is None:
        return False
    if show and not effective:
        return True
    return effective in SAFE_LOG_FORMATS


def _shows_only_blobs(arguments: list[str]) -> bool:
    operands = []
    for argument in arguments:
        if argument == "--":
            break
        if not argument.startswith("-"):
            operands.append(argument)
    return bool(operands) and all(GIT_BLOB_SPEC.fullmatch(operand) for operand in operands)


def _sensitive_git_command(words: list[str]) -> bool:
    subcommand, arguments = _git_subcommand(words)
    if subcommand in {"blame", "cat-file", "commit", "config", "format-patch", "request-pull", "send-email", "shortlog", "whatchanged"}:
        return True
    if subcommand == "var":
        return any(argument.upper() in {"GIT_AUTHOR_IDENT", "GIT_COMMITTER_IDENT"} for argument in arguments)
    if subcommand == "log":
        return not _safe_history_arguments(arguments, show=False)
    if subcommand == "show":
        return not (_safe_history_arguments(arguments, show=True) or _shows_only_blobs(arguments))
    if subcommand == "remote":
        return any(argument in {"-v", "--verbose", "get-url"} for argument in arguments)
    if subcommand == "rev-list":
        return any(argument.startswith(("--format", "--pretty")) for argument in arguments)
    if subcommand == "for-each-ref":
        return any(re.search(r"(?i)(author|committer|creator|email|signature)", argument) for argument in arguments)
    return False


def _without_global_options(executable: str, arguments: list[str]) -> list[str]:
    value_options = CLI_GLOBAL_VALUE_OPTIONS.get(executable)
    if not value_options:
        return arguments
    index = 0
    while index < len(arguments) and arguments[index].startswith("-"):
        index += 2 if arguments[index] in value_options else 1
    return arguments[index:]


def _prints_definitions(command: str, arguments: list[str]) -> bool:
    flags = "".join(argument[1:] for argument in arguments if argument.startswith(("-", "+")) and not argument.startswith(("--", "++")))
    operands = [argument for argument in arguments if not argument.startswith(("-", "+"))]
    if command in {"fc", "functions", "history", "whence", "where"}:
        return True
    if command == "type":
        return "t" not in flags
    if command == "alias":
        return not operands or any("=" not in operand for operand in operands)
    if command in {"declare", "local", "typeset"}:
        return not operands or any(flag in flags for flag in "fFp") or any("=" not in operand for operand in operands)
    if command in {"export", "readonly"}:
        return not operands or "p" in flags
    return command == "set" and not arguments


SEARCH_COMMANDS = frozenset({"ack", "ag", "egrep", "fgrep", "grep", "rg"})
# The search tools take these options with a separate value, so the value is not mistaken for the pattern or a folder.
SEARCH_VALUE_OPTIONS = frozenset(
    {
        "--after-context", "--before-context", "--binary-files", "--color", "--colour", "--context", "--depth", "--devices",
        "--directories", "--encoding", "--exclude", "--exclude-dir", "--exclude-from", "--file", "--file-search-regex",
        "--glob", "--iglob", "--ignore", "--ignore-file", "--include", "--label", "--max-columns", "--max-count",
        "--max-depth", "--path-to-ignore", "--pre", "--regexp", "--sort", "--sortr", "--threads", "--type", "--type-add",
        "--type-not",
    }
)
SEARCH_VALUE_LETTERS = {"ack": "ABCgm", "ag": "ABCGgmp", "egrep": "ABCDdefm", "fgrep": "ABCDdefm", "grep": "ABCDdefm", "rg": "ABCEdefgjMmrTt"}
SEARCH_PATTERN_OPTIONS = frozenset({"-e", "--regexp", "-f", "--file"})


def _working_folder() -> str:
    try:
        return os.path.realpath(os.getcwd())
    except OSError:
        return USER_HOME


# True when the folder is the home folder, a folder above it, or one that holds startup or history files, so a search or
# a find that starts there reaches them. A glob is expanded and every match is looked at.
def _covers_home(operand: str) -> bool:
    expanded = re.sub(r"^(?:~|\$HOME|\$\{HOME\})(?=/|$)", USER_HOME, operand)
    if expanded.startswith("~"):
        expanded = os.path.expanduser(expanded)
    if not os.path.isabs(expanded):
        expanded = os.path.join(_working_folder(), expanded)
    paths = list(itertools.islice(glob.iglob(expanded), MAX_GLOB_MATCHES)) if any(character in expanded for character in "*?[") else [expanded]
    folders = [os.path.join(USER_HOME, "." + folder) for folder in STARTUP_FOLDER_PATHS + STARTUP_HISTORY_FOLDER_PATHS]
    for path in paths:
        target = os.path.realpath(path).rstrip(os.sep) + os.sep
        if (USER_HOME + os.sep).startswith(target) or any((folder + os.sep).startswith(target) or target.startswith(folder + os.sep) for folder in folders):
            return True
    return False


# The pattern comes first unless -e or -f gives it, and what follows are the files and folders to search. Short options
# are read the way getopt does: the first letter that takes a value takes the rest of the word, or the next word.
def _search_targets(executable: str, arguments: list[str]) -> tuple[list[str], bool]:
    letters = SEARCH_VALUE_LETTERS.get(executable, "")
    operands: list[str] = []
    pattern_option = recursive_directories = after_options = False
    index = 0
    while index < len(arguments):
        argument = arguments[index]
        index += 1
        if after_options or not argument.startswith("-") or argument == "-":
            operands.append(argument)
            continue
        if argument == "--":
            after_options = True
            continue
        option = value = ""
        if argument.startswith("--"):
            option, equals, value = argument.partition("=")
            if not equals and option in SEARCH_VALUE_OPTIONS and index < len(arguments):
                value = arguments[index]
                index += 1
        else:
            for position, letter in enumerate(argument[1:], 1):
                if letter in letters:
                    option, value = "-" + letter, argument[position + 1 :]
                    if not value and index < len(arguments):
                        value = arguments[index]
                        index += 1
                    break
        pattern_option = pattern_option or option in SEARCH_PATTERN_OPTIONS
        recursive_directories = recursive_directories or (option in {"-d", "--directories"} and value == "recurse")
    return (operands if pattern_option else operands[1:]), recursive_directories


# A recursive search that starts at the home folder (or above it) reads every startup and history file on the way.
def _searches_home(executable: str, arguments: list[str]) -> bool:
    if not _STARTUP_RULES[0]:
        return False
    options = [argument for argument in arguments if argument.startswith("-")]
    targets, recursive_directories = _search_targets(executable, arguments)
    if executable in {"grep", "egrep", "fgrep"}:
        recursive = recursive_directories or any(argument in {"--recursive", "--dereference-recursive"} or re.fullmatch(r"-[A-Za-z0-9]*[rR][A-Za-z0-9]*", argument) for argument in options)
    elif executable == "rg":
        unrestricted = sum(argument.count("u") for argument in options if re.fullmatch(r"-[A-Za-z]+", argument)) + options.count("--unrestricted")
        recursive = "--hidden" in options or "-." in options or unrestricted >= 2
    else:
        recursive = True
    return recursive and any(_covers_home(target) for target in targets or ["."])


# Only the options before the first operand count, so `bash build.sh --verbose` passes the flag to the script.
def _traces_commands(executable: str, arguments: list[str]) -> bool:
    names = [re.sub(r"[_-]", "", argument).lower() for argument in arguments]
    if executable == "setopt":
        return any(name in TRACE_OPTION_NAMES for name in names)
    if executable == "shopt":
        return any(name in TRACE_OPTION_NAMES for name in names) and any(argument.startswith("-") and "o" in argument for argument in arguments)
    index = 0
    while index < len(arguments) and arguments[index].startswith(("-", "+")) and arguments[index] not in {"-", "--"}:
        argument = arguments[index]
        if TRACE_OPTION.fullmatch(argument):
            return True
        if re.fullmatch(r"[-+][A-Za-z]*o", argument):
            if index + 1 < len(arguments) and names[index + 1] in TRACE_OPTION_NAMES:
                return True
            index += 1
        index += 1
    return False


def _sensitive_chunk(raw_words: list[str]) -> bool:
    if all(ASSIGNMENT.fullmatch(word) or word in SHELL_KEYWORDS for word in raw_words):
        return False
    try:
        words, used_proxy = _unwrap(raw_words)
    except UnresolvableCommand:
        return True
    if not words:
        return True
    normalized = [_normalized(word) for word in words]
    if normalized[0] == TOOL_NAME:
        return not _is_self(words[0])
    if normalized[0] in TRACE_COMMANDS and _traces_commands(normalized[0], words[1:]):
        return True
    if normalized[0] == "eval" and len(words) > 1:
        return _sensitive_command(" ".join(words[1:]), False)
    if normalized[0] in {"bash", "sh", "zsh"}:
        for index, argument in enumerate(words[:-1]):
            if SHELL_COMMAND_OPTION.fullmatch(argument):
                return _sensitive_command(words[index + 1], False)
    if used_proxy and normalized[0] not in SAFE_PROXY_COMMANDS:
        return True
    if normalized[0] in DIRECT_IDENTITY_COMMANDS:
        return True
    if normalized[0] in CREDENTIAL_COMMANDS or (normalized[0] in PRINTING_COMMANDS and any(SECRET_VARIABLE_PATTERN.search(word) for word in words[1:])):
        return True
    printer = normalized[1:] if normalized[0] == "builtin" and len(normalized) > 1 else normalized
    if printer[0] in DEFINITION_PRINTERS and _prints_definitions(printer[0], printer[1:]):
        return True
    if any(word.split("=", 1)[0] in SENSITIVE_FLAGS for word in normalized):
        return True
    if "git" in normalized and (_sensitive_git_command(words) or (_git_subcommand(words)[0] or "").startswith("credential")):
        return True

    executable = normalized[0]
    arguments = _without_global_options(executable, normalized[1:])
    first = arguments[0] if arguments else ""
    second = arguments[1] if len(arguments) > 1 else ""
    raw_arguments = _without_global_options(executable, words[1:])
    startup_operand = bool(raw_arguments) and STARTUP_FILE_PATTERN.search(" " + raw_arguments[0]) is not None
    if executable in {"coderabbit", "cr"} and first in {"auth", "doctor", "stats", "usage"}:
        return True
    if executable in SEARCH_COMMANDS and _searches_home(executable, words[1:]):
        return True
    if executable == "ps" and any(re.fullmatch(r"-?[a-z]*e[a-z]*", argument) for argument in [first] + [item for item in arguments if item.startswith("-")]):
        return True
    if executable == "launchctl" and first in ENVIRONMENT_SERVICE_ACTIONS:
        return True
    if executable == "op" and first not in {"", "--version", "-v", "help", "run"}:
        return True
    if executable == "doppler" and first in {"configs", "secrets"}:
        return True
    if executable == "vault" and first in {"kv", "login", "print", "read", "token", "transit", "unwrap"}:
        return True
    if executable == "sops" and any(argument in {"-d", "--decrypt", "decrypt"} for argument in arguments):
        return True
    if executable == "ansible-vault" and first in {"decrypt", "view"}:
        return True
    if executable == "kubectl" and first in {"describe", "get"} and any(
        part.split("/")[0].split(".")[0].lower() in {"secret", "secrets"} for argument in raw_arguments[1:] for part in argument.split(",")
    ):
        return True
    if executable in {"jq", "gojq", "yq"} and any(JQ_ENVIRONMENT.search(argument) for argument in words[1:]):
        return True
    if executable == "gh" and (first == "auth" or (first == "api" and second in {"user", "/user"})):
        return True
    if executable in {"npm", "pnpm", "yarn"} and first in {"adduser", "login", "logout", "profile", "token", "whoami"}:
        return True
    if executable == "aws" and ((first == "sts" and second == "get-caller-identity") or first == "configure"):
        return True
    if executable == "gcloud" and first in {"auth", "config"}:
        return True
    if executable == "az" and first == "account":
        return True
    if executable == "kubectl" and first == "config":
        return True
    if executable == "security" and first in {"dump-keychain", "find-generic-password", "find-identity", "find-internet-password"}:
        return True
    if executable in {"gpg", "gpg2"} and any(argument.startswith("--list") for argument in arguments):
        return True
    if executable == "ssh-add" and any(argument in {"-l", "-L"} for argument in arguments):
        return True
    if startup_operand:
        return False
    if first == "doctor" or first == "whoami":
        return True
    if first == "status" and executable != "git":
        return True
    if first in GENERIC_PRIVATE_SUBCOMMANDS and (not second or second in GENERIC_PRIVATE_ACTIONS):
        return True
    if first == "config" and any(argument in GENERIC_PRIVATE_ACTIONS or argument in {"--list", "-l", "dump", "view"} for argument in arguments[1:]):
        return True
    return False


def _brace_options(found: re.Match) -> list[str] | None:
    if found.group(1) is not None:
        return found.group(1).split(",")
    start, end = found.group(2), found.group(3)
    numeric = start.lstrip("-").isdigit()
    if numeric != end.lstrip("-").isdigit():
        return ["_"]
    first, last = (int(start), int(end)) if numeric else (ord(start), ord(end))
    if abs(last - first) >= MAX_GLOB_VARIANTS:
        return None
    values = range(first, last + (1 if last >= first else -1), 1 if last >= first else -1)
    return [str(value) if numeric else chr(value) for value in values]


def _expand_braces(word: str) -> list[str] | None:
    pending, done = [word], []
    while pending:
        if len(done) + len(pending) > MAX_GLOB_VARIANTS:
            return None
        current = pending.pop()
        found = BRACE_PATTERN.search(current)
        if found is None:
            done.append(current)
            continue
        options = _brace_options(found)
        if options is None:
            return None
        pending.extend(current[: found.start()] + option + current[found.end() :] for option in options)
    return done


def _could_name_startup_file(pattern: str, dotted: bool) -> bool:
    last = pattern.rsplit("/", 1)[-1].lower()
    return (last.startswith(".") or dotted) and any(fnmatch.fnmatchcase(sample, last) for sample in STARTUP_SAMPLE_NAMES)


# Globs and braces are expanded against the real folders, the way the shell would, so `cat ~/.z*` is seen for what it reads.
# Where the folder is not the home folder or is not known yet (`~user`, `$DIR`, `..`, a copy made by the same command), the
# last part of the pattern is compared with the startup file names instead.
def _glob_names_startup_file(text: str) -> bool:
    # A shell never expands a glob inside quotes, so quoted text (a sed script, a grep pattern) is not looked at; a quoted
    # home folder in front of an unquoted glob still counts as the home folder.
    unquoted = "\n".join(unquoted_lines(re.sub(r'"\$\{?HOME\}?"', "~", text)))
    dotted = DOTGLOB_PATTERN.search(text) is not None
    # Only a word that can be a path to a startup file is expanded (it starts like a path or has a folder in it); a word too
    # long to be an ordinary path is refused, because padding it with ./ or // must not hide the name behind the limit.
    words = []
    for word in re.findall(r"[^\s;&|()<>\"'`]+", unquoted):
        if "/" in word:
            word = os.path.normpath(word)
        if not (word[0] in "~$/.{" or "/" in word):
            continue
        if len(word) > MAX_GLOB_WORD_CHARS:
            if any(character in word for character in "*?[{"):
                return True
        elif GLOB_SYNTAX_PATTERN.search(word):
            words.append(word)
    if len(words) > MAX_GLOB_WORDS:
        return True
    if not words:
        return False
    working = _working_folder()
    from_home = re.search(r"\b(?:cd|pushd)\b", text) is not None or working == USER_HOME
    for word in words:
        variants = _expand_braces(word)
        if variants is None:
            return True
        for variant in variants:
            expanded = re.sub(r"^(?:~|\$HOME|\$\{HOME\})(?=/|$)", USER_HOME, variant, flags=re.IGNORECASE)
            if not any(character in expanded for character in "*?["):
                candidates = [expanded]
            else:
                patterns = [expanded] if os.path.isabs(expanded) else [expanded] + ([os.path.join(USER_HOME, expanded)] if from_home else [])
                candidates = [match for pattern in patterns for match in itertools.islice(glob.iglob(pattern), MAX_GLOB_MATCHES)]
                elsewhere = not (expanded + "/").startswith(USER_HOME + "/") and (os.path.isabs(expanded) or expanded.startswith(("~", "$")) or ".." in expanded.split("/"))
                if (elsewhere or dotted) and _could_name_startup_file(expanded, dotted):
                    return True
            for candidate in candidates:
                shown = candidate + "/" if os.path.isdir(candidate) else candidate
                if STARTUP_FILE_PATTERN.search(shown):
                    return True
    return False


# find matches its own patterns, including hidden files, and can run a reader on every match. When it starts at the home
# folder or above, a pattern that could match a startup file, or a selection that cannot be checked, is refused.
def _find_names_startup_file(text: str) -> bool:
    if re.search(r"\bfind\b", text) is None or not _pipeline_context(text):
        return False
    roots = [word.strip("'\"") for found in FIND_ROOTS.finditer(text) for word in (found.group(1).split() or ["."])]
    if not any(_covers_home(root) for root in roots):
        return False
    if FIND_UNCHECKABLE.search(text):
        return True
    patterns = [(match.group(1) or match.group(2) or match.group(3) or "").replace("\\", "").rsplit("/", 1)[-1].lower() for match in FIND_NAME_PATTERN.finditer(text)]
    return not patterns or any(fnmatch.fnmatchcase(sample, pattern) for pattern in patterns for sample in STARTUP_SAMPLE_NAMES)


# Quotes, backslashes and percent escapes inside a name do not change the file the shell or a URL opens.
def _mentions_startup_file(text: str) -> bool:
    plain = re.sub(r"[\"'\\]", "", re.sub(r"\$(?=['\"])", "", text.replace("\\\n", "")))
    return any(STARTUP_FILE_PATTERN.search(variant) for variant in (text, plain, unquote(plain)))


def _pipeline_context(text: str) -> bool:
    return PIPELINE_OPERATOR_PATTERN.search(text) is not None or any(PIPELINE_WORD_PATTERN.search(line) for line in unquoted_lines(text))


# A sourced path is exempt only when it names one startup file or folder: it cannot climb out with .., use a brace or glob,
# or also name a history file, because sourcing a history file runs its lines and prints them as errors.
def _safe_source(token: str) -> bool:
    return ".." not in token and not any(character in token for character in "{}*?[,") and STARTUP_HISTORY_PATTERN.search(token) is None


def _without_safe_sources(command: str) -> str:
    marked = "\n".join(mark_opening_quotes(line) for line in command.split("\n"))
    pieces, end = [], 0
    for match in SOURCE_STARTUP_PATTERN.finditer(marked):
        if _safe_source(command[match.start() : match.end()]):
            pieces += [command[end : match.start()], " "]
            end = match.end()
    pieces.append(command[end:])
    return "".join(pieces)


def _reads_startup_file(command: str) -> bool:
    if not _STARTUP_RULES[0]:
        return False
    command = JQ_PROGRAM.sub(r"\g<head>x", command)
    if HISTORY_VARIABLE_PATTERN.search(command):
        return True
    if not (_mentions_startup_file(command) or _glob_names_startup_file(command) or _find_names_startup_file(command)):
        return False
    if TRACE_ENVIRONMENT_PATTERN.search(command):
        return True
    remainder = command
    if SHADOWING_PATTERN.search(command) is None:
        remainder = HAS_KEY_STARTUP_PATTERN.sub(" ", _without_safe_sources(command))
        if not _pipeline_context(command):
            remainder = METADATA_STARTUP_PATTERN.sub(" ", remainder)
    return _mentions_startup_file(remainder) or _glob_names_startup_file(remainder) or _find_names_startup_file(remainder)


def _prints_secret_variable(command: str) -> bool:
    if HERE_STRING_SECRET.search(command):
        return True
    secrets = [found.start() for found in SECRET_VARIABLE_PATTERN.finditer(command)]
    if not secrets:
        return False
    for found in HEREDOC_START.finditer(command):
        prefix = command[command.rfind("\n", 0, found.start()) + 1 : found.start()]
        if found.end() <= secrets[-1] and ">" not in prefix:
            return True
    return False


# The command a here-document or substitution belongs to: the words of its simple command with a placeholder where the
# marker is, so a command that follows the marker (`<<'EOF' bash`) counts as much as one before it.
def _owner_words(line: str) -> list[str] | None:
    for chunk in _tokenize(line):
        if HEREDOC_MARKER in chunk:
            words = [word for word in chunk if word != HEREDOC_MARKER]
            while words and words[0] in SHELL_KEYWORDS:
                words = words[1:]
            try:
                words, _ = _unwrap(words) if words else (words, False)
            except UnresolvableCommand:
                return None
            return words or None
    return None


def _is_data_owner(words: list[str] | None) -> bool:
    # A bare name or a system folder only: ./cat or /tmp/x/cat is whatever the file is.
    if not words or not SYSTEM_COMMAND_PATH.fullmatch(words[0]):
        return False
    name = _normalized(words[0])
    if name not in HEREDOC_DATA_COMMANDS:
        return False
    return not (name == "jq" and any(JQ_PROGRAM_FILE.fullmatch(argument) for argument in words[1:]))


def _is_data_heredoc(command: str, document: Any) -> bool:
    if document.line_end - document.line_start > MAX_HEREDOC_LINE_CHARS:
        return False
    tail = command[document.delimiter_end : document.line_end]
    if PIPELINE_OPERATOR_PATTERN.search(tail):
        return False
    if not _is_data_owner(_owner_words(command[document.line_start : document.marker_start] + " " + HEREDOC_MARKER + " " + tail)):
        return False
    # An unquoted body is expanded by the shell, so it must hold nothing but text and plain variables.
    if not document.quoted and HEREDOC_EXPANSION.search(command[document.body_start : document.body_end]):
        return False
    if document.outer is None:
        return True
    line_start, opening, quote = document.outer
    if opening < 0:
        return False
    outer = _owner_words(command[line_start:opening] + quote + " " + HEREDOC_MARKER + " ")
    if not outer or not SYSTEM_COMMAND_PATH.fullmatch(outer[0]) or _normalized(outer[0]) != "gh":
        return False
    arguments = outer[1:]
    last = arguments[-1] if arguments else ""
    option, equals, value = last.partition("=")
    text_argument = (equals and option in GH_TEXT_OPTIONS and not value.startswith("@")) or (
        len(arguments) > 1 and arguments[-2] in GH_TEXT_OPTIONS and not last.startswith("@")
    )
    return bool(arguments) and arguments[0] in HEREDOC_ARGUMENT_COMMANDS["gh"] and bool(text_argument)


# The command outside its here-documents must be plain simple commands: a group, a compound statement, a function, an
# arithmetic or quoting form is where this scan can place a marker differently from a shell, so any of them keeps the
# whole command on the ordinary checks.
def _plain_enough(code: str) -> bool:
    if HEREDOC_FORBIDDEN.search(code) or SHADOWING_PATTERN.search(code):
        return False
    chunks = _tokenize(code)
    return bool(chunks) and not any(chunk[0] in COMPOUND_WORDS for chunk in chunks)


# The code view leaves out every data body, so a line of prose is not read as a command and an odd apostrophe cannot make
# the whole command unparseable. The text view also leaves out quoted bodies, which nothing expands; an unquoted body
# stays in it because the shell expands variables there.
def _heredoc_views(command: str) -> tuple[str, str]:
    documents = [document for document in heredocs(command) if _is_data_heredoc(command, document)]
    if not documents:
        return command, command
    code: list[str] = []
    view: list[str] = []
    position = 0
    for document in documents:
        if document.body_start < position:
            continue
        segment = command[position : document.body_start]
        code.append(segment)
        view.append(segment)
        if not document.quoted:
            view.append(command[document.body_start : document.end])
        position = document.end
    code.append(command[position:])
    view.append(command[position:])
    if not _plain_enough("".join(code)):
        return command, command
    return "".join(code), "".join(view)


# Text that is run as a command by something else (a substitution, a string given to eval or `bash -c`) is checked
# whole: whether a here-document in it is data depends on the command around it, which is only known at the top level.
def _sensitive_command(command: str, data_heredocs: bool = True) -> bool:
    if len(command) > MAX_COMMAND_CHARS:
        return True
    code, command = _heredoc_views(command) if data_heredocs else (command, command)
    lowered = command.lower()
    if (
        DEFINITION_PARAMETER_PATTERN.search(lowered)
        or SENSITIVE_PATH_PATTERN.search(lowered)
        or SENSITIVE_FILE_PATTERN.search(lowered)
        or PROCESS_ENVIRONMENT_PATTERN.search(lowered)
        or _reads_startup_file(command)
        or _prints_secret_variable(command)
    ):
        return True
    if re.search(r"(?<![\w.-])\.env(?!\.(?:dist|example|sample|template)\b)(?:\b|$)", lowered):
        return True
    chunks = _tokenize(code)
    if not chunks or any(_sensitive_chunk(chunk) for chunk in chunks):
        return True
    return any(_sensitive_command(body, False) for body in command_substitutions(code) if body.strip())


# The same holds for a startup file (a name, a glob, a find, a search from the home folder): the agent needs the two safe
# alternatives, not the generic refusal.
def _blocked_only_by_startup_file(command: str) -> bool:
    _STARTUP_RULES[0] = False
    try:
        return not _sensitive_command(command)
    finally:
        _STARTUP_RULES[0] = True


# When the proxy prefix is the only problem the agent needs the one-line fix, not the generic refusal.
def _blocked_only_by_proxy(command: str) -> bool:
    without_proxy = PROXY_PREFIX.sub("rtk", command)
    return without_proxy != command and not _sensitive_command(without_proxy)


class _CheckTooSlow(BaseException):
    """Raised by the budget alarm; it is not an Exception, so no handler inside a check can swallow it."""


_decision_made = [False]


def _on_budget_alarm(signal_number: int, frame: object) -> None:
    if not _decision_made[0]:
        raise _CheckTooSlow


def _set_budget(seconds: float) -> None:
    if hasattr(signal, "setitimer"):
        signal.setitimer(signal.ITIMER_REAL, seconds)


def _deny_hook(reason_key: str = "safe_tool.deny.sensitive") -> None:
    _decision_made[0] = True
    emit_decision("deny", message(reason_key))


# The plugin setting reaches the hook as CLAUDE_PLUGIN_OPTION_REQUIRE_RTK; the variable works on every host.
def _require_rtk() -> bool:
    return env_flag("AGENT_SAFEGUARDS_REQUIRE_RTK") or env_flag("CLAUDE_PLUGIN_OPTION_REQUIRE_RTK")


# This probe is module-level because the hook, the status command and the self-test share one RTK support decision.
def _rtk_required(command: str) -> bool:
    if RTK_PATH is None:
        return False
    completed = _run(
        [RTK_PATH, "rewrite", command],
        cwd=_working_folder(),
        timeout=RTK_REWRITE_TIMEOUT_SECONDS,
    )
    if completed is None or completed.returncode not in {0, 3}:
        return False
    try:
        rewritten = completed.stdout.decode("utf-8").strip()
    except UnicodeDecodeError:
        return False
    return bool(rewritten and rewritten != command.strip())


# This decision stays separate so Git admission requires a visible user confirmation.
def _ask_local_artifact_hook() -> None:
    _decision_made[0] = True
    emit_decision("ask", message("safe_tool.ask.local_artifact"))


def _response_text(value: Any) -> str:
    if isinstance(value, str):
        return value
    if isinstance(value, dict):
        return "\n".join(f"{key}={_response_text(child)}" for key, child in value.items())
    if isinstance(value, list):
        return "\n".join(_response_text(child) for child in value)
    return ""


# The key prefix that _response_text adds would hide a token at the very start of the output, so secrets are scanned without it.
def _response_values(value: Any) -> str:
    if isinstance(value, str):
        return value
    if isinstance(value, dict):
        return "\n".join(_response_values(child) for child in value.values())
    if isinstance(value, list):
        return "\n".join(_response_values(child) for child in value)
    return ""


def _shows_private_address(text: str) -> bool:
    if env_flag("AGENT_SAFEGUARDS_SHOW_ADDRESSES"):
        return False
    stripped = EMULATOR_ADDRESS.sub(" ", text)
    return PRIVATE_ADDRESS_V4.search(stripped) is not None or PRIVATE_ADDRESS_V6.search(stripped) is not None


def _sensitive_output(command: str, response: Any) -> bool:
    text = _response_text(response)
    if contains_secret(_response_values(response)):
        return True
    private_email = any(match.group(1).lower() not in RESERVED_EMAIL_DOMAINS for match in EMAIL_PATTERN.finditer(text))
    identity_context = any(
        _normalized(token) in {"account", "auth", "doctor", "identity", "org", "organization", "profile", "status", "whoami"}
        or "identity" in _normalized(token)
        for text in (command, *command_substitutions(command))
        for chunk in _tokenize(text)
        for token in chunk
    )
    labeled_non_email_identity = NON_EMAIL_IDENTITY_FIELD_PATTERN.search(text) is not None
    values = _response_values(response)
    return (
        private_email
        or (identity_context and labeled_non_email_identity)
        or DEFINITION_OUTPUT_PATTERN.search(values) is not None
        or _shows_private_address(values)
    )


def _withheld_shape(value: Any, *, root: bool = True) -> Any:
    placeholder = message("safe_tool.withheld.placeholder")
    if isinstance(value, dict):
        replacement = {key: _withheld_shape(child, root=False) for key, child in value.items()}
        for key in ("stdout", "output", "content"):
            if key in replacement and isinstance(replacement[key], str):
                replacement[key] = placeholder
                break
        return replacement
    if isinstance(value, list):
        return []
    if isinstance(value, str):
        return placeholder if root else ""
    if isinstance(value, bool) or value is None:
        return value
    if isinstance(value, (int, float)):
        return 0
    return None


def _withhold_post_hook(runtime: str, response: Any) -> None:
    _decision_made[0] = True
    if runtime == "claude":
        if not isinstance(response, dict):
            response = {"stdout": "", "stderr": "", "interrupted": False, "isImage": False}
        emit(
            {
                "hookSpecificOutput": {
                    "hookEventName": "PostToolUse",
                    "updatedToolOutput": _withheld_shape(response),
                }
            }
        )
        return
    emit({"decision": "block", "reason": message("safe_tool.withheld.reason")})


def _command_of(payload: dict[str, Any]) -> str | None:
    tool_input = payload.get("tool_input")
    command = tool_input.get("command") if isinstance(tool_input, dict) else None
    return command if isinstance(command, str) else None


def _handle_event(runtime: str, event: str, payload: dict[str, Any]) -> None:
    if event == "SessionStart":
        cwd = payload.get("cwd")
        if runtime == "claude" and env_flag("AGENT_SAFEGUARDS_AUTO_EXCLUDE") and isinstance(cwd, str):
            _ensure_local_excludes(cwd)
        return
    if event not in {"PreToolUse", "PostToolUse"}:
        return
    command = _command_of(payload)
    if command is None:
        if event == "PostToolUse":
            _withhold_post_hook(runtime, payload.get("tool_response"))
        else:
            _deny_hook()
        return
    if event == "PreToolUse":
        if _sensitive_command(command):
            if _blocked_only_by_proxy(command):
                _deny_hook("safe_tool.deny.proxy")
            else:
                _deny_hook("safe_tool.deny.startup_file" if _blocked_only_by_startup_file(command) else "safe_tool.deny.sensitive")
        elif _require_rtk() and _rtk_required(command):
            _deny_hook("safe_tool.deny.rtk")
        elif runtime == "claude" and _requires_local_artifact_approval(command, payload.get("cwd")):
            _ask_local_artifact_hook()
    elif _sensitive_output(command, payload.get("tool_response")):
        _withhold_post_hook(runtime, payload.get("tool_response"))


# The hook registration names its own event, so an unreadable payload still gets the right kind of refusal.
# Without it (a manual run) the event name is searched for near the start of the payload.
def _fail_closed_unreadable(runtime: str, raw_input: bytes, expected_event: str | None) -> None:
    event = expected_event
    if event is None:
        match = EVENT_PATTERN.search(raw_input[:EVENT_SEARCH_BYTES])
        event = match.group(1).decode("ascii") if match else "PreToolUse"
    if event == "PostToolUse":
        _withhold_post_hook(runtime, None)
    elif event == "PreToolUse":
        _deny_hook()


def _run_hook(runtime: str, expected_event: str | None = None) -> int:
    raw_input = b""
    try:
        raw_input = sys.stdin.buffer.read(MAX_OUTPUT_BYTES + 1)
        if len(raw_input) > MAX_OUTPUT_BYTES:
            raise ValueError
        payload = json.loads(raw_input)
        if not isinstance(payload, dict):
            raise ValueError
    except (OSError, TypeError, ValueError):
        _fail_closed_unreadable(runtime, raw_input, expected_event)
        return 0
    event = expected_event or payload.get("hook_event_name", "PreToolUse")
    if not isinstance(event, str):
        event = "PreToolUse"
    if hasattr(signal, "setitimer"):
        signal.signal(signal.SIGALRM, _on_budget_alarm)
    try:
        _set_budget(HOOK_BUDGET_SECONDS)
        _handle_event(runtime, event, payload)
    except _CheckTooSlow:
        if not fail_open():
            _refuse_unchecked(runtime, event, payload, "safe_tool.deny.too_slow")
    except Exception:
        if not fail_open():
            _refuse_unchecked(runtime, event, payload, "safe_tool.deny.internal")
    finally:
        _set_budget(0)
    return 0


def _refuse_unchecked(runtime: str, event: str, payload: dict[str, Any], reason_key: str) -> None:
    if event == "PreToolUse":
        _deny_hook(reason_key)
    elif event == "PostToolUse":
        _withhold_post_hook(runtime, payload.get("tool_response"))


def _json_payloads(output: bytes) -> list[Any] | None:
    try:
        text = output.decode("utf-8")
    except UnicodeDecodeError:
        return None
    try:
        return [json.loads(text)]
    except json.JSONDecodeError:
        payloads: list[Any] = []
        for line in text.splitlines():
            if not line.strip():
                continue
            try:
                payloads.append(json.loads(line))
            except json.JSONDecodeError:
                return None
        return payloads or None


def _authentication_state(value: Any) -> str | None:
    if isinstance(value, dict):
        for key, child in value.items():
            normalized_key = re.sub(r"[^a-z]", "", str(key).lower())
            if normalized_key in {"authenticated", "isauthenticated", "loggedin", "isloggedin"} and isinstance(child, bool):
                return "ready" if child else "unauthenticated"
            if normalized_key in {"authstatus", "state", "status"} and isinstance(child, str):
                normalized_value = re.sub(r"[^a-z]", "", child.lower())
                if normalized_value in {"authenticated", "loggedin", "ready"}:
                    return "ready"
                if normalized_value in {"expired", "loggedout", "missing", "notauthenticated", "unauthenticated"}:
                    return "unauthenticated"
            nested = _authentication_state(child)
            if nested:
                return nested
    elif isinstance(value, list):
        for child in value:
            nested = _authentication_state(child)
            if nested:
                return nested
    return None


def _rtk_status() -> int:
    enforcement = "on" if _require_rtk() else "off"
    if RTK_PATH is None:
        emit({"tool": "rtk", "status": "unavailable", "enforcement": enforcement})
        return 127
    status = "ready" if _rtk_required("git status --short") else "operation_failed"
    emit({"tool": "rtk", "status": status, "enforcement": enforcement})
    return 0 if status == "ready" else 2


def _coderabbit_status() -> int:
    if CODERABBIT_PATH is None:
        emit({"tool": "coderabbit", "status": "unavailable"})
        return 127
    completed = _run(
        [CODERABBIT_PATH, "auth", "status", "--agent"],
        cwd=os.getcwd(),
        timeout=STATUS_TIMEOUT_SECONDS,
    )
    if completed is None:
        emit({"tool": "coderabbit", "status": "operation_failed"})
        return 2
    payloads = _json_payloads(completed.stdout)
    state = _authentication_state(payloads) if payloads is not None else None
    if state is None:
        emit({"tool": "coderabbit", "status": "schema_mismatch"})
        return 2
    emit({"tool": "coderabbit", "status": state})
    return 0 if state == "ready" else 1


def _git(command: list[str], cwd: str, timeout: int = GIT_TIMEOUT_SECONDS) -> _ProcessResult | None:
    if GIT_PATH is None:
        return None
    return _run([GIT_PATH, "-c", "user.useConfigOnly=true", *command], cwd=cwd, timeout=timeout)


def _repository_root(cwd: str) -> str | None:
    completed = _git(["rev-parse", "--show-toplevel"], cwd, 20)
    if completed is None or completed.returncode != 0:
        return None
    try:
        root = os.path.realpath(completed.stdout.decode("utf-8").strip())
        current = os.path.realpath(cwd)
        if not os.path.isdir(root) or os.path.commonpath((current, root)) != root:
            return None
        return root
    except (UnicodeDecodeError, ValueError):
        return None


# These entries are read per call because the policy comes from the environment, not from a file the agent could edit.
def _local_only_entries() -> tuple[str, ...]:
    configured = env_list("AGENT_SAFEGUARDS_LOCAL_ONLY")
    entries = DEFAULT_LOCAL_ONLY if configured is None else configured
    return tuple(
        entry
        for entry in entries
        if LOCAL_ONLY_ENTRY.fullmatch(entry)
        and re.search(r"[A-Za-z0-9]", entry)
        and ".." not in entry.split("/")
    )


def _local_only_paths() -> tuple[str, ...]:
    return tuple(entry.rstrip("/") for entry in _local_only_entries())


def _local_only_exclude_patterns() -> tuple[str, ...]:
    return tuple("/" + entry for entry in _local_only_entries())


# This Git-owned path is resolved once per event so worktrees use their real local exclude file.
def _git_exclude_path(root: str) -> str | None:
    completed = _git(["rev-parse", "--git-path", "info/exclude"], root, 20)
    if completed is None or completed.returncode != 0:
        return None
    try:
        value = completed.stdout.decode("utf-8").strip()
    except UnicodeDecodeError:
        return None
    path = os.path.abspath(value if os.path.isabs(value) else os.path.join(root, value))
    if os.path.basename(path) != "exclude" or os.path.basename(os.path.dirname(path)) != "info":
        return None
    return path


# Every folder on the way is opened without following links, so a swap after the check fails instead of redirecting the write.
def _open_without_symlinks(path: str) -> int:
    directory_flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    parts = [part for part in path.split(os.sep) if part]
    descriptor = os.open(os.sep, os.O_RDONLY | os.O_DIRECTORY)
    try:
        for part in parts[:-1]:
            following = os.open(part, directory_flags, dir_fd=descriptor)
            os.close(descriptor)
            descriptor = following
        return os.open(parts[-1], os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600, dir_fd=descriptor)
    finally:
        os.close(descriptor)


# This local write is locked because concurrent Claude sessions can start in the same repository.
def _ensure_local_excludes(cwd: str) -> bool:
    patterns = _local_only_exclude_patterns()
    if not patterns:
        return False
    root = _repository_root(cwd)
    if root is None:
        return False
    path = _git_exclude_path(root)
    if path is None or os.path.realpath(path) != path:
        return False
    try:
        descriptor = _open_without_symlinks(path)
        with os.fdopen(descriptor, "r+", encoding="utf-8") as handle:
            if not stat.S_ISREG(os.fstat(handle.fileno()).st_mode):
                return False
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
            content = handle.read()
            existing = set(content.splitlines())
            missing = [pattern for pattern in patterns if pattern not in existing]
            if missing:
                handle.seek(0, os.SEEK_END)
                if content and not content.endswith("\n"):
                    handle.write("\n")
                handle.write("".join(f"{pattern}\n" for pattern in missing))
                handle.flush()
                os.fsync(handle.fileno())
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
    except OSError:
        return False
    return True


# This decoder centralizes NUL-delimited Git paths and rejects malformed output.
def _decoded_paths(result: _ProcessResult | None) -> set[str]:
    if result is None or result.returncode != 0:
        return set()
    try:
        return {path for path in result.stdout.decode("utf-8").split("\0") if path}
    except UnicodeDecodeError:
        return set()


# This fixed query covers ignored and visible untracked artifacts without reading their contents.
def _untracked_local_only_paths(root: str) -> set[str]:
    paths = _local_only_paths()
    if not paths:
        return set()
    visible = _git(["ls-files", "--others", "--exclude-standard", "-z", "--", *paths], root, 20)
    ignored = _git(
        ["ls-files", "--others", "--ignored", "--exclude-standard", "-z", "--", *paths],
        root,
        20,
    )
    return _decoded_paths(visible) | _decoded_paths(ignored)


# This fixed query limits commit approval to newly admitted protected paths.
def _new_staged_local_only_paths(root: str) -> set[str]:
    paths = _local_only_paths()
    if not paths:
        return set()
    staged = _git(
        ["diff", "--cached", "--name-only", "--diff-filter=A", "-z", "--", *paths],
        root,
        20,
    )
    return _decoded_paths(staged)


# This parser is separate because force-add is the staging form that bypasses local excludes.
def _is_force_git_add(raw_words: list[str]) -> bool:
    words, _ = _unwrap(raw_words)
    subcommand, arguments = _git_subcommand(words)
    if subcommand != "add":
        return False
    return any(
        argument == "--force"
        or (argument.startswith("-") and not argument.startswith("--") and "f" in argument[1:])
        for argument in arguments
    )


# This parser recognizes only the approved wrapper and leaves raw commits to the sensitive-command gate.
def _is_safe_tool_commit(raw_words: list[str]) -> bool:
    words, _ = _unwrap(raw_words)
    if len(words) < 3 or not _is_self(words[0]):
        return False
    return [_normalized(word) for word in words[1:3]] == ["git", "commit"]


# This check is model-independent and asks only when a new local artifact can cross into Git.
def _requires_local_artifact_approval(command: str, cwd: Any) -> bool:
    if not isinstance(cwd, str) or not _local_only_entries():
        return False
    root = _repository_root(cwd)
    if root is None:
        return False
    chunks = _tokenize(command)
    if any(_is_force_git_add(chunk) for chunk in chunks) and _untracked_local_only_paths(root):
        return True
    return any(_is_safe_tool_commit(chunk) for chunk in chunks) and bool(_new_staged_local_only_paths(root))


def _git_identity_ready(root: str) -> bool:
    for variable in ("GIT_AUTHOR_IDENT", "GIT_COMMITTER_IDENT"):
        completed = _git(["var", variable], root, 20)
        if completed is None or completed.returncode != 0 or not completed.stdout.strip():
            return False
    return True


def _git_identity() -> int:
    root = _repository_root(os.getcwd())
    if root is None:
        emit({"tool": "git", "operation": "identity", "status": "not_repository"})
        return 2
    status = "configured" if _git_identity_ready(root) else "identity_missing"
    emit({"tool": "git", "operation": "identity", "status": status})
    return 0 if status == "configured" else 1


def _object_id(output: bytes) -> str | None:
    try:
        value = output.decode("ascii").strip()
    except UnicodeDecodeError:
        return None
    return value if OBJECT_ID_PATTERN.fullmatch(value) else None


def _git_commit(messages: list[str]) -> int:
    commit_message = "\n\n".join(messages).strip()
    if (
        not commit_message
        or len(commit_message.encode("utf-8")) > 16 * 1024
        or (env_flag("AGENT_SAFEGUARDS_BLOCK_ATTRIBUTION") and ATTRIBUTION_PATTERN.search(commit_message))
        or _sensitive_output("git commit", commit_message)
    ):
        emit({"tool": "git", "operation": "commit", "status": "invalid_message"})
        return 2
    root = _repository_root(os.getcwd())
    if root is None:
        emit({"tool": "git", "operation": "commit", "status": "not_repository"})
        return 2
    if not _git_identity_ready(root):
        emit({"tool": "git", "operation": "commit", "status": "identity_missing"})
        return 1
    staged = _git(["diff", "--cached", "--quiet", "--exit-code"], root, 20)
    if staged is None or staged.returncode not in {0, 1}:
        emit({"tool": "git", "operation": "commit", "status": "operation_failed"})
        return 2
    if staged.returncode == 0:
        emit({"tool": "git", "operation": "commit", "status": "no_staged_changes"})
        return 1
    candidate = _git(["write-tree"], root, 20)
    paths = _git(["diff", "--cached", "--name-only", "-z"], root, 20)
    candidate_tree = _object_id(candidate.stdout) if candidate and candidate.returncode == 0 else None
    if candidate_tree is None or paths is None or paths.returncode != 0:
        emit({"tool": "git", "operation": "commit", "status": "operation_failed"})
        return 2
    arguments = ["commit", "--quiet", "--no-status"]
    for paragraph in messages:
        arguments.extend(("--message", paragraph))
    completed = _git(arguments, root)
    if completed is None or completed.returncode != 0:
        combined = (completed.stdout + completed.stderr).lower() if completed else b""
        if b"hook" in combined:
            status = "hook_failed"
        elif b"sign" in combined or b"gpg" in combined:
            status = "signing_failed"
        elif b"unmerged" in combined or b"conflict" in combined:
            status = "unmerged_changes"
        else:
            status = "commit_failed"
        emit({"tool": "git", "operation": "commit", "status": status})
        return 1
    commit = _git(["rev-parse", "--verify", "HEAD"], root, 20)
    tree = _git(["rev-parse", "--verify", "HEAD^{tree}"], root, 20)
    commit_id = _object_id(commit.stdout) if commit and commit.returncode == 0 else None
    tree_id = _object_id(tree.stdout) if tree and tree.returncode == 0 else None
    if commit_id is None or tree_id is None:
        emit({"tool": "git", "operation": "commit", "status": "verification_failed"})
        return 2
    status = "committed" if tree_id == candidate_tree else "committed_tree_changed"
    emit(
        {
            "tool": "git",
            "operation": "commit",
            "status": status,
            "commit": commit_id,
            "tree": tree_id,
            "files": paths.stdout.count(b"\0"),
        }
    )
    return 0 if status == "committed" else 2


def _self_test() -> int:
    blocked = (
        "coderabbit auth status",
        "rtk proxy coderabbit auth status",
        "bash -lc 'coderabbit auth status'",
        "git config --get user.email",
        "git -C /tmp/repository config --get user.name",
        "git var GIT_AUTHOR_IDENT",
        "git commit -m test",
        "git log -1",
        "git show HEAD",
        "gh auth status",
        "aws sts get-caller-identity",
        "vendor account show",
        "vendor status",
        "cat ~/.gitconfig",
        "security find-identity -v -p codesigning",
        "rtk proxy security find-identity -v -p codesigning",
        "rtk proxy ./gradlew test",
        "./other/safe-tool env",
    )
    allowed = (
        "safe-tool status coderabbit",
        "safe-tool git identity",
        "safe-tool git commit -m test",
        "git log --oneline -5",
        "git show --format= --stat HEAD",
        "rtk git status --short",
        "rtk proxy git diff --stat",
        'rg "git config" AGENTS.md',
    )
    status_payload = [{"type": "status", "authenticated": True, "email": "withheld@example.invalid"}]
    secret_output = {"stdout": "token=" + "ghp_" + ("A" * 32), "stderr": ""}
    identity_output = {"stdout": "email=owner@corp" + ".internal", "stderr": ""}
    name_output = {"stdout": "name=PrivateUser", "stderr": ""}
    rtk_checks = True
    if RTK_PATH is not None and _require_rtk():
        rtk_checks = (
            _rtk_required("git status --short")
            and not _rtk_required("rtk git status --short")
            and not _rtk_required("printf ok")
        )
    passed = (
        all(_sensitive_command(command) for command in blocked)
        and all(not _sensitive_command(command) for command in allowed)
        and _authentication_state(status_payload) == "ready"
        and _sensitive_output("tool status", secret_output)
        and _sensitive_output("tool status", identity_output)
        and _sensitive_output("tool status", name_output)
        and rtk_checks
    )
    emit({"tool": TOOL_NAME, "status": "self_test_passed" if passed else "self_test_failed"})
    return 0 if passed else 1


def _commit_messages(arguments: list[str]) -> list[str] | None:
    messages: list[str] = []
    index = 0
    while index < len(arguments):
        argument = arguments[index]
        if argument in {"-m", "--message"} and index + 1 < len(arguments):
            messages.append(arguments[index + 1])
            index += 2
        elif argument.startswith("--message="):
            messages.append(argument.split("=", 1)[1])
            index += 1
        else:
            return None
    return messages or None


def _startup_key_file(requested: str | None) -> str | None:
    requested = "~/.zshrc" if requested is None else requested
    expanded = USER_HOME + requested[1:] if requested.startswith("~/") else requested
    if not os.path.isabs(expanded) or os.path.realpath(os.path.dirname(expanded)) != USER_HOME or os.path.basename(expanded) not in STARTUP_KEY_FILES:
        return None
    # A dotfile manager may link the file elsewhere in the home folder, but not out of it.
    # and the link must still lead to a file that is named like a startup file, so it cannot be pointed at any other file.
    if os.path.lexists(expanded):
        target = os.path.realpath(expanded)
        if not (target + os.sep).startswith(USER_HOME + os.sep) or not any(name.lstrip(".") in os.path.basename(target).lower() for name in STARTUP_KEY_FILES):
            return None
    return expanded


def _apply_command(words: list[str], found: set[str]) -> None:
    while words and words[0] in {"then", "do", "else", "!"}:
        words = words[1:]
    if not words:
        return
    if words[0] == "unset":
        found.difference_update(word for word in words[1:] if not word.startswith("-"))
        return
    keyword = words[0] in {"export", "readonly", "declare", "typeset"}
    rest = words[1:] if keyword else words
    while keyword and rest and re.fullmatch(r"-[A-Za-z]+", rest[0]):
        rest = rest[1:]
    assignments = []
    for token in rest:
        match = re.fullmatch(r"([A-Za-z_][A-Za-z0-9_]*)\+?=(.*)", token, re.DOTALL)
        if match:
            assignments.append((match.group(1), match.group(2)))
        elif not keyword:
            return
    for name, value in assignments:
        if value:
            found.add(name)
        else:
            found.discard(name)


def _apply_line(line: str, found: set[str]) -> None:
    try:
        lexer = shlex.shlex(re.sub(r"\$\([^()]*\)|`[^`]*`", "x", line), posix=True, punctuation_chars=";&|")
        lexer.whitespace_split = True
        lexer.commenters = "#"
        tokens = list(lexer)
    except ValueError:
        return
    command: list[str] = []
    for token in tokens:
        if token and all(character in ";&|" for character in token):
            _apply_command(command, found)
            command = []
        else:
            command.append(token)
    _apply_command(command, found)


def _keys_set_in(path: str) -> tuple[set[str], bool]:
    found: set[str] = set()
    pending = ""
    try:
        with open(path, encoding="utf-8", errors="replace") as handle:
            for number, line in enumerate(handle):
                if number >= MAX_STARTUP_FILE_LINES or len(pending) > MAX_STARTUP_LINE_CHARS:
                    return found, False
                line = pending + line
                pending = line[:-2] if line.endswith("\\\n") else ""
                if not pending:
                    _apply_line(line, found)
    except FileNotFoundError:
        return set(), True
    except OSError:
        return set(), False
    return found, True


# A key check prints only the name and pass or fail, never the value, so an agent can learn that a key is set without reading the file.
def _has_key(arguments: list[str]) -> int:
    names: list[str] = []
    requested = None
    index = 0
    while index < len(arguments):
        argument = arguments[index]
        if argument == "--file" and requested is None and index + 1 < len(arguments):
            requested = arguments[index + 1]
            index += 2
        elif KEY_NAME_PATTERN.fullmatch(argument):
            names.append(argument)
            index += 1
        else:
            names = []
            break
    path = _startup_key_file(requested)
    if not names or len(names) > MAX_KEY_NAMES or path is None:
        sys.stderr.write(message("safe_tool.cli.usage") + "\n")
        return 2
    found, complete = _keys_set_in(path)
    sys.stdout.write("".join("%s=%s\n" % (name, "pass" if name in found else ("fail" if complete else "unknown")) for name in names))
    return 0


# The command line is parsed by hand so every printed word comes from the message catalog.
def main() -> int:
    arguments = sys.argv[1:]
    if arguments in (["-h"], ["--help"]):
        sys.stdout.write(message("safe_tool.cli.usage") + "\n")
        return 0
    if arguments[:1] == ["hook"] and 2 <= len(arguments) <= 3 and arguments[1] in {"claude", "codex"}:
        if len(arguments) == 2:
            return _run_hook(arguments[1])
        if arguments[2] in HOOK_EVENTS:
            return _run_hook(arguments[1], arguments[2])
    if arguments == ["self-test"]:
        return _self_test()
    if arguments == ["status", "coderabbit"]:
        return _coderabbit_status()
    if arguments == ["status", "rtk"]:
        return _rtk_status()
    if arguments[:1] == ["has-key"]:
        return _has_key(arguments[1:])
    if arguments == ["git", "identity"]:
        return _git_identity()
    if arguments[:2] == ["git", "commit"]:
        messages = _commit_messages(arguments[2:])
        if messages is not None:
            return _git_commit(messages)
    sys.stderr.write(message("safe_tool.cli.usage") + "\n")
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
